:root {
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #f8fafc;
  background: #080d18;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --page-bg: #080d18;
  --card: #111a2b;
  --input: #0d1422;
  --text: #f8fafc;
  --muted: #a9b4c7;
  --muted-2: #758198;
  --accent: #e31b2d;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  min-width: 320px;
  min-height: 100%;
  margin: 0;
}

body {
  min-height: 100vh;
  background: var(--page-bg);
}

button,
input {
  font: inherit;
}

button {
  border: 0;
}

.admin-login-page {
  position: relative;
  display: flex;
  min-height: 100svh;
  flex-direction: column;
  overflow: hidden;
  background: #080d18;
  isolation: isolate;
}

.admin-login-page::before {
  content: "";
  position: absolute;
  z-index: -2;
  top: -205px;
  left: 50%;
  width: 700px;
  height: 500px;
  transform: translateX(-50%);
  border-radius: 9999px;
  background: rgba(58, 22, 32, 0.3);
  filter: blur(65px);
  pointer-events: none;
}

.admin-login-page::after {
  content: "";
  position: absolute;
  z-index: -2;
  right: 192px;
  bottom: 0;
  width: 450px;
  height: 350px;
  border-radius: 9999px;
  background: rgba(0, 124, 168, 0.1);
  filter: blur(60px);
  pointer-events: none;
}

.admin-login-page__content {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  height: 784px;
  flex: 0 0 784px;
  align-items: center;
  justify-content: center;
  padding: 48px 20px;
}

.admin-login-page__content::before {
  content: "";
  position: absolute;
  top: calc(50% - 386px);
  left: 50%;
  width: 288px;
  height: 176px;
  transform: translateX(-50%);
  border-radius: 9999px;
  background: rgba(227, 27, 45, 0.15);
  filter: blur(40px);
  pointer-events: none;
}

.admin-login-page__content > * {
  position: relative;
}

.admin-login-page__content {
  flex-direction: column;
}

.brand {
  position: relative;
  width: 460px;
  height: 138px;
  flex: 0 0 138px;
  text-align: center;
}

.brand__logo-wrap {
  position: absolute;
  top: 0;
  left: 50%;
  display: flex;
  width: 80px;
  height: 80px;
  transform: translateX(-50%);
  align-items: center;
  justify-content: center;
  padding: 8px;
  border-radius: 16px;
  background: #111a2b;
  box-shadow:
    0 20px 25px -5px rgba(8, 13, 24, 0.6),
    0 8px 10px -6px rgba(8, 13, 24, 0.6),
    0 0 10px rgba(227, 27, 45, 0.22);
}

.brand__logo {
  display: block;
  width: 64px;
  height: 64px;
  border-radius: 12px;
  object-fit: cover;
}

.brand__title {
  position: absolute;
  top: 92px;
  left: 0;
  display: flex;
  width: 100%;
  margin: 0;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: #f8fafc;
  font-size: 20px;
  font-weight: 700;
  line-height: 26px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.brand__title-accent {
  color: var(--accent);
}

.brand__subtitle {
  position: absolute;
  top: 122px;
  left: 0;
  width: 100%;
  margin: 0;
  color: #758198;
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
  letter-spacing: 2.64px;
  text-transform: uppercase;
}

.login-card {
  position: relative;
  width: 460px;
  height: 458px;
  flex: 0 0 458px;
  margin-top: 49px;
  padding: 40px 32px 0;
  border-radius: 16px;
  background: #111a2b;
  box-shadow: 0 25px 50px -12px #080d18;
}

.login-card__heading h2 {
  margin: 0;
  color: #f8fafc;
  font-size: 24px;
  font-weight: 700;
  line-height: 30px;
  letter-spacing: -0.24px;
}

.login-card__heading p {
  margin: 4px 0 0;
  color: #a9b4c7;
  font-size: 14px;
  font-weight: 400;
  line-height: 22px;
}

.login-form {
  margin-top: 16px;
}

.field-group {
  width: 100%;
}

.field-group--email {
  margin-bottom: 16px;
}

.field-group--password {
  margin-bottom: 0;
}

.field-group label {
  display: block;
  margin: 0 0 4px;
  color: #a9b4c7;
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
  letter-spacing: 0.6px;
}

.input-shell {
  position: relative;
  display: flex;
  width: 100%;
  height: 50px;
  align-items: center;
  border-radius: 12px;
  background: #0d1422;
}

.input-shell input {
  width: 100%;
  height: 50px;
  min-width: 0;
  margin: 0;
  padding: 0 16px 0 44px;
  border: 0;
  outline: 0;
  border-radius: 12px;
  background: transparent;
  color: #f8fafc;
  font-size: 14px;
  font-weight: 400;
  line-height: normal;
  caret-color: #f8fafc;
}

.field-group--password .input-shell input {
  padding-right: 48px;
}

.input-shell input::placeholder {
  color: #758198;
  opacity: 1;
}

.input-shell input:-webkit-autofill,
.input-shell input:-webkit-autofill:hover,
.input-shell input:-webkit-autofill:focus,
.input-shell input:-webkit-autofill:active {
  -webkit-text-fill-color: #f8fafc !important;
  caret-color: #f8fafc;
  box-shadow: 0 0 0 1000px #0d1422 inset !important;
  -webkit-box-shadow: 0 0 0 1000px #0d1422 inset !important;
  transition: background-color 9999s ease-out 0s;
}

.input-shell:focus-within {
  box-shadow: 0 0 0 1px rgba(227, 27, 45, 0.35);
}

.input-icon {
  position: absolute;
  z-index: 1;
  display: block;
  pointer-events: none;
}

.input-icon--email {
  top: 16.67px;
  left: 15.67px;
  width: 16.667px;
  height: 16.667px;
}

.input-icon--lock {
  top: 15.83px;
  left: 17.33px;
  width: 13.333px;
  height: 17.5px;
}

.password-toggle {
  position: absolute;
  top: 11px;
  right: 14px;
  display: flex;
  width: 26.333px;
  height: 20.5px;
  align-items: center;
  justify-content: center;
  padding: 4px;
  border-radius: 4px;
  background: transparent;
  color: #758198;
  cursor: pointer;
}

.password-toggle img {
  display: block;
  width: 18.333px;
  height: 12.5px;
}

.login-form__meta {
  display: flex;
  width: 100%;
  height: 46px;
  align-items: flex-start;
  justify-content: space-between;
  padding-top: 16px;
  padding-bottom: 12px;
}

.remember {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #a9b4c7;
  font-size: 13px;
  font-weight: 400;
  line-height: 18px;
  cursor: pointer;
}

.remember input {
  width: 16px;
  height: 16px;
  margin: 1px 0 0;
  border-radius: 2.5px;
  accent-color: #e31b2d;
}

.forgot-password {
  padding: 0;
  background: transparent;
  color: #758198;
  font-size: 13px;
  font-weight: 400;
  line-height: 18px;
  cursor: pointer;
}

.login-button {
  display: flex;
  width: 100%;
  height: 50px;
  align-items: center;
  justify-content: center;
  margin: 12px 0 0;
  border-radius: 12px;
  background: #e31b2d;
  box-shadow:
    0 10px 15px -3px rgba(227, 27, 45, 0.25),
    0 4px 6px -4px rgba(227, 27, 45, 0.25);
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  line-height: 14px;
  letter-spacing: 0.14px;
  cursor: pointer;
}

.login-button:hover {
  background: #ef2235;
}

.login-button:active {
  transform: translateY(1px);
}

.site-footer {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-top: auto;
  padding: 24px 20px 26px;
  color: #647087;
  text-align: center;
  font-size: 11px;
  line-height: 18px;
}

@media (max-width: 520px) {
  .admin-login-page__content {
    height: auto;
    min-height: calc(100svh - 70px);
    flex: 1 1 auto;
    padding: 36px 16px 30px;
  }

  .brand,
  .login-card {
    width: min(100%, 460px);
  }

  .login-card {
    height: auto;
    min-height: 458px;
  }

  .site-footer {
    padding-bottom: 20px;
  }
}

@media (max-height: 820px) and (min-width: 521px) {
  .admin-login-page__content {
    height: auto;
    min-height: 720px;
    flex: 1 1 auto;
    padding-top: 30px;
    padding-bottom: 30px;
  }

  .login-card {
    margin-top: 36px;
  }
}


/* Reset Sandi */
.reset-page {
  position: relative;
  display: flex;
  min-height: 100svh;
  flex-direction: column;
  overflow: hidden;
  background: #080d18;
  isolation: isolate;
}

.reset-page::before {
  content: "";
  position: absolute;
  z-index: -2;
  top: -205px;
  left: 50%;
  width: 700px;
  height: 500px;
  transform: translateX(-50%);
  border-radius: 9999px;
  background: rgba(58, 22, 32, 0.3);
  filter: blur(65px);
  pointer-events: none;
}

.reset-page::after {
  content: "";
  position: absolute;
  z-index: -2;
  right: 192px;
  bottom: 0;
  width: 450px;
  height: 350px;
  border-radius: 9999px;
  background: rgba(0, 124, 168, 0.1);
  filter: blur(60px);
  pointer-events: none;
}

.reset-page__main {
  position: relative;
  width: 100%;
  height: 965px;
  flex: 0 0 965px;
}

.reset-page__brand {
  position: absolute;
  top: 26px;
  left: 50%;
  width: 460px;
  transform: translateX(-50%);
}

.reset-page__brand::before {
  content: "";
  position: absolute;
  top: -64px;
  left: 50%;
  width: 288px;
  height: 176px;
  transform: translateX(-50%);
  border-radius: 9999px;
  background: rgba(227, 27, 45, 0.15);
  filter: blur(40px);
  pointer-events: none;
}

.reset-card {
  position: absolute;
  top: 231px;
  left: 50%;
  display: flex;
  width: 520px;
  height: 433px;
  transform: translateX(-50%);
  flex-direction: column;
  gap: 24px;
  padding: 49px;
  overflow: hidden;
  border: 1px solid #253149;
  border-radius: 16px;
  background: rgba(17, 26, 43, 0.98);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(2px);
}

.reset-card::before {
  content: "";
  position: absolute;
  top: -96px;
  left: 50%;
  width: 192px;
  height: 96px;
  transform: translateX(-50%);
  border-radius: 9999px;
  background: rgba(227, 27, 45, 0.15);
  filter: blur(20px);
  pointer-events: none;
}

.reset-card__heading {
  position: relative;
  padding-bottom: 8px;
}

.reset-card__heading h2 {
  margin: 0;
  color: #f8fafc;
  font-size: 24px;
  font-weight: 700;
  line-height: 26px;
  letter-spacing: -0.1px;
}

.reset-card__heading p {
  margin: 4px 0 0;
  color: #a9b4c7;
  font-size: 14px;
  font-weight: 400;
  line-height: 22px;
}

.reset-form {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 24px;
  padding-bottom: 8px;
}

.reset-field label {
  display: block;
  margin-bottom: 4px;
  color: #a9b4c7;
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
  letter-spacing: 0.6px;
}

.reset-input-shell {
  position: relative;
  display: flex;
  width: 100%;
  height: 52px;
  align-items: center;
  border: 1px solid #253149;
  border-radius: 12px;
  background: #080d18;
}

.reset-input-shell:focus-within {
  border-color: rgba(227, 27, 45, 0.6);
  box-shadow: 0 0 0 3px rgba(227, 27, 45, 0.08);
}

.reset-input-shell input {
  width: 100%;
  height: 50px;
  min-width: 0;
  padding: 0 17px 0 45px;
  border: 0;
  outline: 0;
  border-radius: 12px;
  background: transparent;
  color: #f8fafc;
  font-size: 14px;
  font-weight: 400;
  caret-color: #f8fafc;
}

.reset-input-shell input::placeholder {
  color: #758198;
  opacity: 1;
}

.reset-input-shell input:-webkit-autofill,
.reset-input-shell input:-webkit-autofill:hover,
.reset-input-shell input:-webkit-autofill:focus,
.reset-input-shell input:-webkit-autofill:active {
  -webkit-text-fill-color: #f8fafc !important;
  caret-color: #f8fafc;
  box-shadow: 0 0 0 1000px #080d18 inset !important;
  -webkit-box-shadow: 0 0 0 1000px #080d18 inset !important;
  transition: background-color 9999s ease-out 0s;
}

.reset-input-icon {
  position: absolute;
  top: 17.67px;
  left: 17.67px;
  width: 16.667px;
  height: 16.667px;
  pointer-events: none;
}

.reset-submit {
  display: flex;
  width: 100%;
  height: 54px;
  align-items: center;
  justify-content: center;
  padding-top: 4px;
  border-radius: 12px;
  background: #e31b2d;
  box-shadow:
    0 10px 15px -3px rgba(227, 27, 45, 0.2),
    0 4px 6px -4px rgba(227, 27, 45, 0.2);
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  line-height: 14px;
  letter-spacing: 0.14px;
  cursor: pointer;
}

.reset-submit:hover {
  background: #ef2235;
}

.reset-back {
  display: inline-flex;
  align-self: center;
  align-items: center;
  gap: 8px;
  padding: 4px 12px;
  border-radius: 8px;
  background: transparent;
  color: #a9b4c7;
  font-size: 13px;
  font-weight: 400;
  line-height: 18px;
  cursor: pointer;
}

.reset-back:hover {
  color: #f8fafc;
  background: rgba(255, 255, 255, 0.03);
}

.reset-back img {
  width: 10.667px;
  height: 10.667px;
}

.reset-page .site-footer {
  height: 88px;
  flex: 0 0 88px;
  margin-top: 0;
  padding: 24px 20px;
  color: #758198;
  font-size: 11px;
  line-height: 20px;
  letter-spacing: 0.275px;
}

@media (max-width: 620px) {
  .reset-page__main {
    height: auto;
    min-height: calc(100svh - 88px);
    flex: 1 1 auto;
    padding: 34px 16px 40px;
  }

  .reset-page__brand,
  .reset-card {
    position: relative;
    top: auto;
    left: auto;
    width: min(100%, 520px);
    transform: none;
    margin-right: auto;
    margin-left: auto;
  }

  .reset-page__brand {
    width: min(100%, 460px);
  }

  .reset-card {
    height: auto;
    min-height: 433px;
    margin-top: 42px;
    padding: 36px 24px;
  }

  .reset-card__heading p br {
    display: none;
  }

  .reset-page::after {
    right: -160px;
  }
}

@media (max-width: 380px) {
  .reset-card {
    padding-right: 20px;
    padding-left: 20px;
  }

  .reset-card__heading h2 {
    font-size: 22px;
  }
}


/* Kode OTP */
.otp-page,
.new-password-page {
  position: relative;
  display: flex;
  min-height: 100svh;
  flex-direction: column;
  overflow: hidden;
  background: #080d18;
  isolation: isolate;
}

.otp-page::before,
.new-password-page::before {
  content: "";
  position: absolute;
  z-index: -2;
  top: -205px;
  left: 50%;
  width: 700px;
  height: 500px;
  transform: translateX(-50%);
  border-radius: 9999px;
  background: rgba(58, 22, 32, 0.3);
  filter: blur(65px);
  pointer-events: none;
}

.otp-page::after,
.new-password-page::after {
  content: "";
  position: absolute;
  z-index: -2;
  right: 192px;
  bottom: 0;
  width: 450px;
  height: 350px;
  border-radius: 9999px;
  background: rgba(0, 124, 168, 0.1);
  filter: blur(60px);
  pointer-events: none;
}

.otp-page__main,
.new-password-page__main {
  position: relative;
  width: 100%;
  height: 784px;
  flex: 0 0 784px;
}

.otp-page__brand,
.new-password-page__brand {
  position: absolute;
  top: 57px;
  left: 50%;
  width: 460px;
  transform: translateX(-50%);
}

.otp-page__brand::before,
.new-password-page__brand::before {
  content: "";
  position: absolute;
  top: -64px;
  left: 50%;
  width: 288px;
  height: 176px;
  transform: translateX(-50%);
  border-radius: 9999px;
  background: rgba(227, 27, 45, 0.15);
  filter: blur(40px);
  pointer-events: none;
}

.otp-card {
  position: absolute;
  top: 252px;
  left: 50%;
  width: 612px;
  height: 458px;
  transform: translateX(-50%);
  overflow: hidden;
  border-radius: 16px;
  background: #111a2b;
  box-shadow:
    0 20px 25px -5px rgba(0, 0, 0, 0.1),
    0 8px 10px -6px rgba(0, 0, 0, 0.1);
}

.otp-card::before {
  content: "";
  position: absolute;
  top: -96px;
  left: 50%;
  width: 256px;
  height: 128px;
  transform: translateX(-50%);
  border-radius: 9999px;
  background: rgba(227, 27, 45, 0.1);
  filter: blur(30px);
  pointer-events: none;
}

.otp-card__header {
  position: absolute;
  top: 60px;
  left: 32px;
  right: 32px;
  text-align: center;
}

.otp-card__header h2 {
  margin: 0;
  color: #f8fafc;
  font-size: 20px;
  font-weight: 700;
  line-height: 26px;
  letter-spacing: -0.5px;
}

.otp-card__header p {
  margin: 4px 0 0;
  color: #a9b4c7;
  font-size: 14px;
  line-height: 22px;
}

.otp-card__header strong {
  display: block;
  margin-top: 1px;
  color: #f8fafc;
  font-size: 12px;
  font-weight: 700;
  line-height: 16px;
}

.otp-form {
  position: absolute;
  top: 202px;
  left: 32px;
  right: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.otp-inputs {
  display: flex;
  justify-content: center;
  gap: 16px;
  width: 100%;
  padding-bottom: 24px;
}

.otp-inputs input {
  width: 64px;
  height: 64px;
  padding: 0;
  border: 0;
  outline: 0;
  border-radius: 12px;
  background: #172236;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  color: #f8fafc;
  text-align: center;
  font-size: 26px;
  font-weight: 700;
  caret-color: #e31b2d;
}

.otp-inputs input:focus {
  box-shadow:
    0 0 0 1px #e31b2d,
    0 0 0 4px rgba(227, 27, 45, 0.08);
}

.otp-resend-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding-bottom: 24px;
  color: #758198;
  font-size: 13px;
  line-height: 18px;
}

.otp-resend {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0;
  background: transparent;
  color: #a9b4c7;
  cursor: pointer;
}

.otp-resend span,
.otp-resend b {
  font-size: 11px;
  line-height: 14px;
  letter-spacing: 0.44px;
}

.otp-resend span {
  font-weight: 600;
}

.otp-resend b {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  font-weight: 700;
}

.otp-resend--disabled {
  color: #758198;
  cursor: default;
}

.otp-submit {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  background: #e31b2d;
  box-shadow:
    0 10px 15px -3px rgba(227, 27, 45, 0.2),
    0 4px 6px -4px rgba(227, 27, 45, 0.2);
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  line-height: 14px;
  letter-spacing: 0.14px;
  cursor: pointer;
}

.otp-submit:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.otp-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  margin-top: 16px;
  padding: 4px 0;
  background: transparent;
  color: #a9b4c7;
  font-size: 13px;
  line-height: 18px;
  cursor: pointer;
}

.otp-back img {
  width: 10.667px;
  height: 10.667px;
}

.otp-page .site-footer,
.new-password-page .site-footer {
  height: 88px;
  flex: 0 0 88px;
  margin-top: auto;
  padding: 24px 20px;
  color: #758198;
  font-size: 11px;
  line-height: 20px;
  letter-spacing: 0.275px;
}

/* Sandi Baru */
.new-password-card {
  position: absolute;
  top: 222px;
  left: 50%;
  width: 480px;
  height: 491px;
  transform: translateX(-50%);
  border-radius: 16px;
  background: #111a2b;
  box-shadow:
    0 20px 25px -5px rgba(0, 0, 0, 0.1),
    0 8px 10px -6px rgba(0, 0, 0, 0.1);
}

.new-password-card__heading {
  position: absolute;
  top: 56px;
  left: 32px;
  right: 32px;
}

.new-password-card__heading h2 {
  margin: 0;
  color: #f8fafc;
  font-size: 24px;
  font-weight: 700;
  line-height: 25px;
  letter-spacing: -0.1px;
}

.new-password-form {
  position: absolute;
  top: 131px;
  left: 32px;
  right: 32px;
}

.new-password-field {
  width: 100%;
}

.new-password-field--confirm {
  margin-top: 16px;
}

.new-password-field label {
  display: block;
  margin-bottom: 4px;
  color: #a9b4c7;
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
  letter-spacing: 0.6px;
}

.new-password-input {
  position: relative;
  width: 100%;
  height: 52px;
  border: 1px solid #253149;
  border-radius: 12px;
  background: #080d18;
}

.new-password-input:focus-within {
  border-color: rgba(227, 27, 45, 0.55);
  box-shadow: 0 0 0 3px rgba(227, 27, 45, 0.08);
}

.new-password-input input {
  width: 100%;
  height: 50px;
  padding: 0 44px;
  border: 0;
  outline: 0;
  border-radius: 12px;
  background: transparent;
  color: #f8fafc;
  font-size: 14px;
}

.new-password-input input::placeholder {
  color: #758198;
  opacity: 1;
}

.new-password-lock {
  position: absolute;
  top: 17px;
  left: 17px;
  width: 13.333px;
  height: 17.5px;
}

.new-password-eye {
  position: absolute;
  top: 16px;
  right: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18.333px;
  height: 12.5px;
  padding: 0;
  background: transparent;
  color: #758198;
  cursor: pointer;
}

.new-password-eye img {
  width: 18.333px;
  height: 12.5px;
}

.new-password-helper {
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 22px;
  padding-top: 4px;
  color: #758198;
  font-size: 12px;
  line-height: 18px;
}

.new-password-helper--valid {
  color: #9cc7ad;
}

.new-password-submit {
  width: 100%;
  height: 52px;
  margin-top: 16px;
  border-radius: 12px;
  background: #e31b2d;
  box-shadow:
    0 10px 15px -3px rgba(227, 27, 45, 0.2),
    0 4px 6px -4px rgba(227, 27, 45, 0.2);
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  line-height: 14px;
  cursor: pointer;
}

.new-password-submit:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.new-password-footer-action {
  position: absolute;
  left: 32px;
  right: 32px;
  top: 402px;
  height: 54px;
  padding-top: 24px;
  text-align: center;
}

.new-password-back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0;
  background: transparent;
  color: #a9b4c7;
  font-size: 13px;
  line-height: 14px;
  cursor: pointer;
}

.new-password-back img {
  width: 12px;
  height: 12px;
}

@media (max-width: 680px) {
  .otp-page__main,
  .new-password-page__main {
    height: auto;
    min-height: calc(100svh - 88px);
    flex: 1 1 auto;
    padding: 34px 16px 40px;
  }

  .otp-page__brand,
  .new-password-page__brand,
  .otp-card,
  .new-password-card {
    position: relative;
    top: auto;
    left: auto;
    transform: none;
    margin-right: auto;
    margin-left: auto;
  }

  .otp-page__brand,
  .new-password-page__brand {
    width: min(100%, 460px);
  }

  .otp-card {
    width: min(100%, 612px);
    height: auto;
    min-height: 458px;
    margin-top: 42px;
  }

  .otp-card__header,
  .otp-form {
    position: relative;
    top: auto;
    left: auto;
    right: auto;
    padding-right: 24px;
    padding-left: 24px;
  }

  .otp-card__header {
    padding-top: 48px;
  }

  .otp-form {
    margin-top: 42px;
    padding-bottom: 34px;
  }

  .otp-inputs {
    gap: 10px;
  }

  .otp-inputs input {
    width: min(18vw, 64px);
    height: min(18vw, 64px);
  }

  .new-password-card {
    width: min(100%, 480px);
    height: auto;
    min-height: 491px;
    margin-top: 42px;
    padding: 48px 24px 34px;
  }

  .new-password-card__heading,
  .new-password-form,
  .new-password-footer-action {
    position: relative;
    top: auto;
    left: auto;
    right: auto;
  }

  .new-password-form {
    margin-top: 48px;
  }

  .new-password-footer-action {
    margin-top: 24px;
    padding-top: 0;
  }
}

@media (max-width: 390px) {
  .otp-card__header h2 {
    font-size: 19px;
  }

  .otp-card__header p {
    font-size: 13px;
  }

  .otp-resend-row {
    flex-wrap: wrap;
  }
}


/* Beranda Admin */
.dashboard-page {
  display: flex;
  min-height: 100svh;
  background: #080d18;
  color: #f8fafc;
}

.dashboard-sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 20;
  display: flex;
  width: 256px;
  flex-direction: column;
  border-right: 1px solid #1c2638;
  background: #0d1422;
}

.dashboard-sidebar__brand {
  display: flex;
  height: 80px;
  align-items: center;
  gap: 14px;
  padding: 0 24px;
  border-bottom: 1px solid #1c2638;
}

.dashboard-sidebar__brand img {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  object-fit: cover;
}

.dashboard-sidebar__brand div {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.dashboard-sidebar__brand strong {
  color: #f8fafc;
  font-size: 13px;
  line-height: 17px;
  letter-spacing: 0.3px;
}

.dashboard-sidebar__brand span {
  color: #758198;
  font-size: 10px;
  line-height: 17px;
  letter-spacing: 1.2px;
}

.dashboard-nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 20px 12px;
}

.dashboard-nav__item {
  display: flex;
  width: 100%;
  height: 41px;
  align-items: center;
  gap: 12px;
  padding: 0 14px;
  border-radius: 10px;
  background: transparent;
  color: #8d99ae;
  font-size: 14px;
  cursor: pointer;
  text-align: left;
}

.dashboard-nav__item:hover {
  background: #121d30;
  color: #e8edf5;
}

.dashboard-nav__item--active {
  background: rgba(227, 27, 45, 0.12);
  color: #f8fafc;
  box-shadow: inset 3px 0 0 #e31b2d;
}

.dashboard-nav__item--active svg {
  color: #e31b2d;
}

.dashboard-sidebar__bottom {
  margin-top: auto;
  padding: 14px;
  border-top: 1px solid #1c2638;
}

.dashboard-profile {
  display: flex;
  min-height: 57px;
  align-items: center;
  gap: 10px;
  padding: 10px 10px;
  border: 1px solid #253149;
  border-radius: 12px;
  background: rgba(23, 34, 54, 0.45);
}

.dashboard-profile__avatar {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  place-items: center;
  border: 1px solid #33415c;
  border-radius: 50%;
  background: #172236;
  color: #f8fafc;
  font-size: 13px;
  font-weight: 700;
}

.dashboard-profile__text {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.dashboard-profile__text strong {
  overflow: hidden;
  color: #f8fafc;
  font-size: 13px;
  line-height: 18px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dashboard-profile__text span {
  color: #758198;
  font-size: 11px;
  line-height: 15px;
}

.dashboard-profile__logout {
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  border-radius: 8px;
  background: transparent;
  color: #758198;
  cursor: pointer;
}

.dashboard-profile__logout:hover {
  background: rgba(227, 27, 45, 0.1);
  color: #e31b2d;
}

.dashboard-shell {
  width: calc(100% - 256px);
  min-height: 100svh;
  margin-left: 256px;
}

.dashboard-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  height: 80px;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  border-bottom: 1px solid #1c2638;
  background: rgba(8, 13, 24, 0.94);
  backdrop-filter: blur(12px);
}

.dashboard-header h1 {
  margin: 0;
  color: #f8fafc;
  font-size: 24px;
  font-weight: 700;
  line-height: 30px;
}

.dashboard-header__actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.dashboard-period {
  display: inline-flex;
  height: 30px;
  align-items: center;
  gap: 8px;
  padding: 0 15px;
  border: 1px solid #253149;
  border-radius: 999px;
  background: rgba(23, 34, 54, 0.45);
  color: #a9b4c7;
  font-size: 12px;
}

.dashboard-period__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #34c759;
  box-shadow: 0 0 0 4px rgba(52, 199, 89, 0.08);
}

.dashboard-notification {
  position: relative;
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border: 1px solid #253149;
  border-radius: 10px;
  background: #111a2b;
  color: #a9b4c7;
  cursor: pointer;
}

.dashboard-notification span {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 7px;
  height: 7px;
  border: 1.5px solid #111a2b;
  border-radius: 50%;
  background: #e31b2d;
}

.dashboard-content {
  padding: 28px 32px 36px;
}

.dashboard-welcome {
  display: flex;
  min-height: 112px;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 24px 26px;
  border: 1px solid #253149;
  border-radius: 16px;
  background:
    radial-gradient(circle at 90% 10%, rgba(227, 27, 45, 0.14), transparent 30%),
    #111a2b;
}

.dashboard-eyebrow {
  margin: 0 0 8px;
  color: #e31b2d;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.dashboard-welcome h2 {
  margin: 0;
  font-size: 22px;
  line-height: 28px;
}

.dashboard-welcome p:not(.dashboard-eyebrow) {
  margin: 6px 0 0;
  color: #8d99ae;
  font-size: 13px;
  line-height: 20px;
}

.dashboard-welcome__badge {
  display: flex;
  min-width: 164px;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border: 1px solid #253149;
  border-radius: 12px;
  background: rgba(8, 13, 24, 0.55);
  color: #e31b2d;
}

.dashboard-welcome__badge div {
  display: flex;
  flex-direction: column;
}

.dashboard-welcome__badge span {
  color: #758198;
  font-size: 10px;
}

.dashboard-welcome__badge strong {
  margin-top: 2px;
  color: #f8fafc;
  font-size: 13px;
}

.dashboard-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-top: 18px;
}

.dashboard-stat-card {
  display: flex;
  min-height: 118px;
  gap: 14px;
  padding: 18px;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
}

.dashboard-stat-card__icon {
  display: grid;
  width: 38px;
  height: 38px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 10px;
  background: rgba(227, 27, 45, 0.1);
  color: #e31b2d;
}

.dashboard-stat-card__body {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.dashboard-stat-card__body > span {
  color: #8d99ae;
  font-size: 11px;
  line-height: 16px;
}

.dashboard-stat-card__body strong {
  margin-top: 3px;
  color: #f8fafc;
  font-size: 26px;
  line-height: 30px;
}

.dashboard-stat-card__body small {
  margin-top: 5px;
  color: #647087;
  font-size: 10px;
  line-height: 14px;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.8fr);
  gap: 18px;
  margin-top: 18px;
}

.dashboard-panel {
  min-width: 0;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
}

.dashboard-panel__heading {
  display: flex;
  min-height: 72px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 18px;
  border-bottom: 1px solid #1f2a3d;
}

.dashboard-panel__heading h3 {
  margin: 0;
  color: #f8fafc;
  font-size: 15px;
  line-height: 20px;
}

.dashboard-panel__heading p {
  margin: 3px 0 0;
  color: #758198;
  font-size: 11px;
  line-height: 16px;
}

.dashboard-panel__heading button {
  padding: 7px 10px;
  border-radius: 8px;
  background: rgba(227, 27, 45, 0.1);
  color: #e31b2d;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
}

.dashboard-table-wrap {
  overflow-x: auto;
}

.dashboard-table {
  width: 100%;
  border-collapse: collapse;
}

.dashboard-table th,
.dashboard-table td {
  padding: 12px 16px;
  border-bottom: 1px solid #1b2536;
  text-align: left;
  white-space: nowrap;
}

.dashboard-table th {
  color: #647087;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.4px;
  text-transform: uppercase;
}

.dashboard-table td {
  color: #a9b4c7;
  font-size: 11px;
}

.dashboard-table tbody tr:last-child td {
  border-bottom: 0;
}

.dashboard-table tbody tr:hover {
  background: rgba(255, 255, 255, 0.015);
}

.status-pill {
  display: inline-flex;
  min-width: 68px;
  height: 22px;
  align-items: center;
  justify-content: center;
  padding: 0 8px;
  border-radius: 999px;
  background: rgba(255, 184, 0, 0.09);
  color: #d3a32c;
  font-size: 10px;
  font-weight: 600;
}

.status-pill--accepted {
  background: rgba(52, 199, 89, 0.09);
  color: #72c98a;
}

.dashboard-activity-list {
  display: flex;
  flex-direction: column;
  padding: 6px 18px 16px;
}

.dashboard-activity-item {
  position: relative;
  display: flex;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid #1b2536;
}

.dashboard-activity-item:last-child {
  border-bottom: 0;
}

.dashboard-activity-item__dot {
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  margin-top: 5px;
  border-radius: 50%;
  background: #e31b2d;
  box-shadow: 0 0 0 4px rgba(227, 27, 45, 0.08);
}

.dashboard-activity-item div {
  min-width: 0;
}

.dashboard-activity-item strong {
  color: #dbe2ed;
  font-size: 11px;
  line-height: 16px;
}

.dashboard-activity-item p {
  margin: 3px 0 0;
  color: #758198;
  font-size: 10px;
  line-height: 15px;
}

.dashboard-activity-item small {
  display: block;
  margin-top: 4px;
  color: #566176;
  font-size: 9px;
}

@media (max-width: 1050px) {
  .dashboard-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .dashboard-sidebar {
    position: static;
    width: 100%;
    min-height: auto;
    border-right: 0;
    border-bottom: 1px solid #1c2638;
  }

  .dashboard-page {
    flex-direction: column;
  }

  .dashboard-sidebar__brand {
    height: 68px;
  }

  .dashboard-nav {
    flex-direction: row;
    overflow-x: auto;
    padding: 10px 12px;
  }

  .dashboard-nav__item {
    width: auto;
    min-width: max-content;
  }

  .dashboard-sidebar__bottom {
    display: none;
  }

  .dashboard-shell {
    width: 100%;
    margin-left: 0;
  }

  .dashboard-header {
    height: 68px;
    padding: 0 18px;
  }

  .dashboard-header__actions {
    gap: 8px;
  }

  .dashboard-period {
    display: none;
  }

  .dashboard-content {
    padding: 18px;
  }

  .dashboard-welcome {
    align-items: flex-start;
    flex-direction: column;
  }

  .dashboard-welcome__badge {
    width: 100%;
  }
}

@media (max-width: 540px) {
  .dashboard-stats {
    grid-template-columns: 1fr;
  }

  .dashboard-header h1 {
    font-size: 21px;
  }

  .dashboard-welcome h2 {
    font-size: 19px;
  }
}


/* ===== Beranda — matched to Figma frame "Beranda" (50:670) ===== */
.beranda-page {
  display: flex;
  width: 100%;
  min-height: 100svh;
  background: #080d18;
  color: #f8fafc;
}

.beranda-sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 20;
  display: flex;
  width: 256px;
  min-height: 100svh;
  flex-direction: column;
  border-right: 1px solid #1d283b;
  background: #111a2b;
}

.beranda-brand {
  display: flex;
  height: 80px;
  flex: 0 0 80px;
  align-items: center;
  gap: 12px;
  padding: 0 24px;
  border-bottom: 1px solid #1d283b;
}

.beranda-brand img {
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  border-radius: 8px;
  object-fit: cover;
}

.beranda-brand__copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
}

.beranda-brand__copy strong {
  overflow: hidden;
  color: #f8fafc;
  font-size: 13px;
  font-weight: 700;
  line-height: 17px;
  letter-spacing: 0.1px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.beranda-brand__copy span {
  margin-top: 1px;
  color: #758198;
  font-size: 9px;
  font-weight: 600;
  line-height: 12px;
  letter-spacing: 1.25px;
}

.beranda-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 20px 12px 0;
}

.beranda-nav__item {
  position: relative;
  display: flex;
  width: 100%;
  height: 41px;
  align-items: center;
  gap: 12px;
  padding: 0 14px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #8d99ae;
  font-size: 13px;
  font-weight: 500;
  line-height: 18px;
  text-align: left;
  cursor: pointer;
}

.beranda-nav__item svg {
  flex: 0 0 auto;
  color: #7f8ba0;
}

.beranda-nav__item--active {
  background: rgba(227, 27, 45, 0.14);
  color: #e7b3b8;
}

.beranda-nav__item--active::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 3px;
  border-radius: 3px;
  background: #e31b2d;
  box-shadow: 0 0 10px rgba(227, 27, 45, 0.25);
}

.beranda-nav__item--active svg {
  color: #d98e96;
}

.beranda-sidebar__bottom {
  margin-top: auto;
  padding: 14px;
  border-top: 1px solid #1d283b;
}

.beranda-admin {
  display: flex;
  min-height: 57px;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  border: 1px solid #253149;
  border-radius: 10px;
  background: #131e31;
}

.beranda-admin__avatar {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  place-items: center;
  border: 1px solid rgba(227, 27, 45, 0.35);
  border-radius: 50%;
  background: rgba(227, 27, 45, 0.18);
  color: #e6a5ab;
  font-size: 11px;
  font-weight: 700;
}

.beranda-admin__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.beranda-admin__copy strong {
  overflow: hidden;
  color: #f8fafc;
  font-size: 11px;
  font-weight: 700;
  line-height: 15px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.beranda-admin__copy span {
  margin-top: 1px;
  color: #758198;
  font-size: 8px;
  font-weight: 600;
  line-height: 11px;
  letter-spacing: 1px;
}

.beranda-admin__logout {
  display: grid;
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  place-items: center;
  border-radius: 7px;
  background: transparent;
  color: #758198;
  cursor: pointer;
}

.beranda-admin__logout:hover {
  background: rgba(255, 255, 255, 0.03);
  color: #a9b4c7;
}

.beranda-main {
  width: calc(100% - 256px);
  min-height: 100svh;
  margin-left: 256px;
  background: #080d18;
}

.beranda-header {
  display: flex;
  height: 80px;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  border-bottom: 1px solid #1d283b;
  background: #080d18;
}

.beranda-header h1 {
  margin: 0;
  color: #f8fafc;
  font-size: 24px;
  font-weight: 700;
  line-height: 30px;
  letter-spacing: -0.25px;
}

.beranda-header__actions {
  display: flex;
  align-items: center;
  gap: 14px;
}

.beranda-period {
  display: inline-flex;
  height: 30px;
  align-items: center;
  gap: 8px;
  padding: 0 14px;
  border: 1px solid #253149;
  border-radius: 999px;
  background: #0d1422;
  color: #a9b4c7;
  font-size: 11px;
  font-weight: 500;
  line-height: 16px;
  white-space: nowrap;
}

.beranda-period__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #23c55e;
  box-shadow: 0 0 0 3px rgba(35, 197, 94, 0.08);
}

.beranda-notification {
  position: relative;
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border: 1px solid #253149;
  border-radius: 10px;
  background: #0d1422;
  color: #8d99ae;
  cursor: pointer;
}

.beranda-notification__dot {
  position: absolute;
  top: 6px;
  right: 7px;
  width: 7px;
  height: 7px;
  border: 1.5px solid #0d1422;
  border-radius: 50%;
  background: #e31b2d;
}

.beranda-content {
  padding: 32px;
}

.beranda-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
}

.beranda-summary-card {
  display: flex;
  height: 168px;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24px;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
}

.beranda-summary-card__label {
  margin: 0;
  color: #758198;
  font-size: 12px;
  font-weight: 500;
  line-height: 17px;
}

.beranda-summary-card__value {
  display: flex;
  align-items: baseline;
  gap: 5px;
  margin-top: 24px;
}

.beranda-summary-card__value strong {
  color: #f8fafc;
  font-size: 32px;
  font-weight: 700;
  line-height: 34px;
  letter-spacing: -0.4px;
}

.beranda-summary-card__value span {
  color: #758198;
  font-size: 11px;
  font-weight: 400;
  line-height: 16px;
}

.beranda-summary-card__badge {
  display: inline-flex;
  height: 24px;
  align-items: center;
  gap: 6px;
  margin-top: 18px;
  padding: 0 9px;
  border-radius: 5px;
  font-size: 10px;
  font-weight: 600;
  line-height: 14px;
}

.beranda-summary-card__badge > span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.beranda-summary-card__badge--warning {
  background: rgba(180, 121, 0, 0.22);
  color: #d49500;
}

.beranda-summary-card__badge--warning > span {
  background: #d49500;
}

.beranda-summary-card__badge--info {
  background: rgba(54, 149, 200, 0.08);
  color: #758198;
}

.beranda-summary-card__badge--info > span {
  background: #4db6df;
  box-shadow: 0 0 6px rgba(77, 182, 223, 0.45);
}

.beranda-summary-card__icon {
  display: grid;
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  place-items: center;
  border-radius: 8px;
}

.beranda-summary-card__icon--warning {
  background: rgba(180, 121, 0, 0.28);
  color: #d49500;
}

.beranda-summary-card__icon--info {
  background: rgba(54, 149, 200, 0.08);
  color: #55a8d0;
}

.beranda-table-card {
  margin-top: 32px;
  overflow: hidden;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
}

.beranda-table-card__head {
  display: flex;
  min-height: 76px;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 16px 24px;
  border-bottom: 1px solid #253149;
}

.beranda-table-card__head h2 {
  margin: 0;
  color: #f8fafc;
  font-size: 16px;
  font-weight: 700;
  line-height: 21px;
}

.beranda-table-card__head p {
  margin: 3px 0 0;
  color: #758198;
  font-size: 10px;
  font-weight: 400;
  line-height: 14px;
}

.beranda-see-all {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0;
  background: transparent;
  color: #cf7f88;
  font-size: 11px;
  font-weight: 600;
  line-height: 16px;
  white-space: nowrap;
  cursor: pointer;
}

.beranda-table-wrap {
  width: 100%;
  overflow-x: auto;
}

.beranda-table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
}

.beranda-table th,
.beranda-table td {
  height: 51px;
  padding: 0 24px;
  border-bottom: 1px solid #1e293b;
  text-align: left;
  vertical-align: middle;
  white-space: nowrap;
}

.beranda-table th {
  height: 47px;
  color: #758198;
  font-size: 9px;
  font-weight: 600;
  line-height: 12px;
  letter-spacing: 0.65px;
}

.beranda-table td {
  color: #8f9bad;
  font-size: 10px;
  font-weight: 400;
  line-height: 14px;
}

.beranda-table tbody tr:last-child td {
  border-bottom: 0;
}

.beranda-table__name {
  color: #e5eaf1 !important;
  font-size: 10px !important;
  font-weight: 600 !important;
}

.beranda-table th:nth-child(1),
.beranda-table td:nth-child(1) {
  width: 20%;
}

.beranda-table th:nth-child(2),
.beranda-table td:nth-child(2) {
  width: 11%;
}

.beranda-table th:nth-child(3),
.beranda-table td:nth-child(3) {
  width: 17%;
}

.beranda-table th:nth-child(4),
.beranda-table td:nth-child(4) {
  width: 18%;
}

.beranda-table th:nth-child(5),
.beranda-table td:nth-child(5) {
  width: 22%;
}

.beranda-table th:nth-child(6),
.beranda-table td:nth-child(6) {
  width: 12%;
  text-align: right;
}

.beranda-status {
  display: inline-flex;
  min-height: 24px;
  align-items: center;
  gap: 6px;
  padding: 0 10px;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 600;
  line-height: 13px;
}

.beranda-status i {
  width: 6px;
  height: 6px;
  flex: 0 0 6px;
  border-radius: 50%;
}

.beranda-status--waiting {
  background: rgba(180, 121, 0, 0.22);
  color: #d49500;
}

.beranda-status--waiting i {
  background: #d49500;
}

.beranda-status--accepted {
  background: rgba(22, 163, 74, 0.17);
  color: #22c55e;
}

.beranda-status--accepted i {
  background: #22c55e;
}

.beranda-status--rejected {
  background: rgba(220, 38, 38, 0.16);
  color: #ef4444;
}

.beranda-status--rejected i {
  background: #ef4444;
}

.beranda-detail {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0;
  background: transparent;
  color: #a9b4c7;
  font-size: 9px;
  font-weight: 500;
  line-height: 13px;
  cursor: pointer;
}

@media (max-width: 980px) {
  .beranda-summary {
    grid-template-columns: 1fr;
  }

  .beranda-summary-card {
    height: auto;
    min-height: 154px;
  }

  .beranda-table {
    min-width: 850px;
  }
}

@media (max-width: 760px) {
  .beranda-page {
    flex-direction: column;
  }

  .beranda-sidebar {
    position: static;
    width: 100%;
    min-height: 0;
    border-right: 0;
    border-bottom: 1px solid #1d283b;
  }

  .beranda-brand {
    height: 68px;
    flex-basis: 68px;
  }

  .beranda-nav {
    flex-direction: row;
    overflow-x: auto;
    padding: 10px 12px;
  }

  .beranda-nav__item {
    width: auto;
    min-width: max-content;
  }

  .beranda-nav__item--active::before {
    top: auto;
    right: 0;
    bottom: 0;
    width: auto;
    height: 3px;
  }

  .beranda-sidebar__bottom {
    display: none;
  }

  .beranda-main {
    width: 100%;
    margin-left: 0;
  }

  .beranda-header {
    height: 68px;
    padding: 0 18px;
  }

  .beranda-header h1 {
    font-size: 21px;
  }

  .beranda-period {
    display: none;
  }

  .beranda-content {
    padding: 18px;
  }

  .beranda-table-card {
    margin-top: 18px;
  }
}


/* ===== Pendaftar — matched to Figma frame "Pendaftar" (58:819) ===== */
.pendaftar-page {
  display: flex;
  width: 100%;
  min-height: 100svh;
  background: #080d18;
  color: #f8fafc;
}

.pendaftar-main {
  width: calc(100% - 256px);
  min-height: 100svh;
  margin-left: 256px;
  background: #080d18;
}

.pendaftar-content {
  padding: 32px;
}

.pendaftar-filter-card {
  display: grid;
  grid-template-columns: minmax(250px, 1.65fr) minmax(138px, 0.82fr) minmax(145px, 0.88fr) minmax(145px, 0.95fr) 132px;
  gap: 12px;
  align-items: center;
  min-height: 88px;
  padding: 20px;
  border: 1px solid #1f2a3d;
  border-radius: 14px;
  background: #111a2b;
}

.pendaftar-search {
  position: relative;
  display: flex;
  height: 48px;
  align-items: center;
  border: 1px solid #2a3750;
  border-radius: 10px;
  background: #0d1422;
}

.pendaftar-search svg {
  position: absolute;
  left: 15px;
  color: #758198;
  pointer-events: none;
}

.pendaftar-search input {
  width: 100%;
  height: 46px;
  padding: 0 14px 0 44px;
  border: 0;
  outline: 0;
  border-radius: 10px;
  background: transparent;
  color: #f8fafc;
  font-size: 13px;
  font-weight: 400;
}

.pendaftar-search input::placeholder {
  color: #758198;
  opacity: 1;
}

.pendaftar-filter-card select {
  width: 100%;
  height: 48px;
  padding: 0 38px 0 14px;
  border: 1px solid #2a3750;
  outline: 0;
  border-radius: 10px;
  background:
    linear-gradient(45deg, transparent 50%, #758198 50%) calc(100% - 18px) 21px / 6px 6px no-repeat,
    linear-gradient(135deg, #758198 50%, transparent 50%) calc(100% - 13px) 21px / 6px 6px no-repeat,
    #0d1422;
  color: #d0d7e3;
  font-size: 12px;
  font-weight: 500;
  appearance: none;
  cursor: pointer;
}

.pendaftar-search:focus-within,
.pendaftar-filter-card select:focus {
  border-color: #3a4966;
  box-shadow: 0 0 0 2px rgba(77, 182, 223, 0.04);
}

.pendaftar-reset {
  display: inline-flex;
  width: 100%;
  height: 48px;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border: 1px solid #2a3750;
  border-radius: 10px;
  background: #0d1422;
  color: #a9b4c7;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
}

.pendaftar-reset:hover {
  background: #121b2c;
  color: #d8dee8;
}

.pendaftar-table-card {
  margin-top: 24px;
  overflow: hidden;
  border: 1px solid #1f2a3d;
  border-radius: 14px;
  background: #111a2b;
}

.pendaftar-table-scroll {
  width: 100%;
  overflow-x: auto;
}

.pendaftar-table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
}

.pendaftar-table th,
.pendaftar-table td {
  height: 60px;
  padding: 0 18px;
  border-bottom: 1px solid #1f2a3d;
  vertical-align: middle;
  text-align: left;
  white-space: nowrap;
}

.pendaftar-table th {
  height: 58px;
  color: #758198;
  font-size: 9px;
  font-weight: 700;
  line-height: 12px;
  letter-spacing: 0.65px;
}

.pendaftar-table td {
  color: #8e9aaf;
  font-size: 10px;
  font-weight: 400;
  line-height: 14px;
}

.pendaftar-table th:nth-child(1),
.pendaftar-table td:nth-child(1) {
  width: 22%;
}

.pendaftar-table th:nth-child(2),
.pendaftar-table td:nth-child(2) {
  width: 9%;
}

.pendaftar-table th:nth-child(3),
.pendaftar-table td:nth-child(3) {
  width: 21%;
}

.pendaftar-table th:nth-child(4),
.pendaftar-table td:nth-child(4) {
  width: 14%;
}

.pendaftar-table th:nth-child(5),
.pendaftar-table td:nth-child(5) {
  width: 12%;
}

.pendaftar-table th:nth-child(6),
.pendaftar-table td:nth-child(6) {
  width: 15%;
}

.pendaftar-table th:nth-child(7),
.pendaftar-table td:nth-child(7) {
  width: 7%;
  text-align: right;
}

.pendaftar-person {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12px;
}

.pendaftar-person__avatar {
  display: grid;
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  place-items: center;
  border-radius: 50%;
  background: #182237;
  color: #e7ebf2;
  font-size: 10px;
  font-weight: 700;
}

.pendaftar-person > div {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.pendaftar-person strong {
  overflow: hidden;
  color: #f3f6fa;
  font-size: 11px;
  font-weight: 700;
  line-height: 15px;
  text-overflow: ellipsis;
}

.pendaftar-person span:not(.pendaftar-person__avatar) {
  margin-top: 2px;
  overflow: hidden;
  color: #758198;
  font-size: 9px;
  font-weight: 400;
  line-height: 12px;
  text-overflow: ellipsis;
}

.pendaftar-game {
  display: inline-flex;
  min-height: 24px;
  align-items: center;
  gap: 6px;
  padding: 0 9px;
  border-radius: 5px;
  background: #172236;
  color: #e0e5ed;
  font-size: 9px;
  font-weight: 600;
  line-height: 13px;
}

.pendaftar-game i {
  width: 6px;
  height: 6px;
  flex: 0 0 6px;
  border-radius: 50%;
  background: #8592a8;
}

.pendaftar-game--valorant i {
  background: #ff314f;
}

.pendaftar-game--mobile-legends i {
  background: #5fc7f3;
}

.pendaftar-game--pubg-mobile i {
  background: #f1a500;
}

.pendaftar-game--efootball i {
  display: none;
}

.pendaftar-detail {
  display: inline-flex;
  height: 32px;
  min-width: 68px;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 0 10px;
  border: 1px solid #253149;
  border-radius: 7px;
  background: #172236;
  color: #a9b4c7;
  font-size: 10px;
  font-weight: 500;
  line-height: 14px;
  cursor: pointer;
}

.pendaftar-detail:hover {
  border-color: #33415c;
  color: #e7ebf2;
}

.pendaftar-empty {
  display: grid;
  min-height: 120px;
  place-items: center;
  color: #758198;
  font-size: 12px;
}

.pendaftar-pagination {
  display: flex;
  min-height: 68px;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 0 20px;
}

.pendaftar-pagination p {
  margin: 0;
  color: #758198;
  font-size: 11px;
  line-height: 16px;
}

.pendaftar-pagination p strong {
  color: #dfe5ee;
  font-weight: 700;
}

.pendaftar-pagination__controls {
  display: flex;
  align-items: center;
  gap: 8px;
}

.pendaftar-page-button {
  display: inline-flex;
  min-width: 36px;
  height: 36px;
  align-items: center;
  justify-content: center;
  padding: 0 10px;
  border: 0;
  border-radius: 7px;
  background: #172236;
  color: #758198;
  font-size: 11px;
  font-weight: 600;
  line-height: 14px;
  cursor: pointer;
}

.pendaftar-page-button--wide {
  min-width: 92px;
  color: #8d99ae;
}

.pendaftar-page-button--active {
  background: #e31b2d;
  color: #fff;
  box-shadow: 0 5px 14px rgba(227, 27, 45, 0.2);
}

.pendaftar-page-button:disabled {
  opacity: 0.35;
  cursor: default;
}

.pendaftar-pagination__ellipsis {
  min-width: 22px;
  color: #647087;
  text-align: center;
  font-size: 12px;
}

@media (max-width: 1120px) {
  .pendaftar-filter-card {
    grid-template-columns: minmax(220px, 1.5fr) repeat(2, minmax(135px, 1fr));
  }

  .pendaftar-filter-card select:nth-of-type(3) {
    grid-column: 1 / 2;
  }

  .pendaftar-reset {
    grid-column: 2 / 3;
  }

  .pendaftar-table {
    min-width: 980px;
  }
}

@media (max-width: 760px) {
  .pendaftar-page {
    flex-direction: column;
  }

  .pendaftar-main {
    width: 100%;
    margin-left: 0;
  }

  .pendaftar-content {
    padding: 18px;
  }

  .pendaftar-filter-card {
    grid-template-columns: 1fr;
    gap: 10px;
    padding: 14px;
  }

  .pendaftar-filter-card select:nth-of-type(3),
  .pendaftar-reset {
    grid-column: auto;
  }

  .pendaftar-pagination {
    align-items: flex-start;
    flex-direction: column;
    padding: 14px 16px 18px;
  }

  .pendaftar-pagination__controls {
    max-width: 100%;
    overflow-x: auto;
    padding-bottom: 2px;
  }
}

/* Pendaftar table column refinement */
.pendaftar-table th:nth-child(1),
.pendaftar-table td:nth-child(1) { width: 21%; }
.pendaftar-table th:nth-child(2),
.pendaftar-table td:nth-child(2) { width: 9%; }
.pendaftar-table th:nth-child(3),
.pendaftar-table td:nth-child(3) { width: 20%; }
.pendaftar-table th:nth-child(4),
.pendaftar-table td:nth-child(4) { width: 13%; }
.pendaftar-table th:nth-child(5),
.pendaftar-table td:nth-child(5) { width: 12%; }
.pendaftar-table th:nth-child(6),
.pendaftar-table td:nth-child(6) { width: 16%; }
.pendaftar-table th:nth-child(7),
.pendaftar-table td:nth-child(7) {
  width: 9%;
  padding-right: 14px;
  padding-left: 10px;
}
.pendaftar-detail {
  min-width: 62px;
  height: 32px;
}
 

/* ===== Detail Pendaftar — matched to Figma frame "Detail Pendaftar" (60:1222) ===== */
.detail-pendaftar-page {
  display: flex;
  width: 100%;
  min-height: 100svh;
  background: #080d18;
  color: #f8fafc;
}

.detail-pendaftar-main {
  width: calc(100% - 256px);
  min-height: 100svh;
  margin-left: 256px;
  background: #080d18;
}

.detail-pendaftar-content {
  width: 100%;
  max-width: 1024px;
  margin: 0 auto;
  padding: 28px 32px 36px;
}

.detail-pendaftar-back {
  display: inline-flex;
  height: 32px;
  align-items: center;
  gap: 7px;
  margin-bottom: 18px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #8d99ae;
  font-size: 11px;
  font-weight: 500;
  line-height: 16px;
  cursor: pointer;
}

.detail-pendaftar-back:hover {
  color: #e8edf5;
}

.detail-pendaftar-hero {
  display: flex;
  min-height: 96px;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 20px 24px;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
}

.detail-pendaftar-hero__title-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.detail-pendaftar-hero h2 {
  margin: 0;
  color: #f8fafc;
  font-size: 20px;
  font-weight: 700;
  line-height: 26px;
  letter-spacing: -0.2px;
}

.detail-pendaftar-hero__id {
  display: inline-flex;
  height: 22px;
  align-items: center;
  padding: 0 8px;
  border-radius: 5px;
  background: #172236;
  color: #758198;
  font-size: 9px;
  font-weight: 600;
}

.detail-pendaftar-hero p {
  margin: 5px 0 0;
  color: #758198;
  font-size: 11px;
  line-height: 16px;
}

.detail-pendaftar-status {
  display: inline-flex;
  min-height: 28px;
  align-items: center;
  gap: 7px;
  padding: 0 11px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 600;
  line-height: 14px;
  white-space: nowrap;
}

.detail-pendaftar-status i,
.detail-pendaftar-review__status i {
  width: 6px;
  height: 6px;
  flex: 0 0 6px;
  border-radius: 50%;
}

.detail-pendaftar-status--waiting {
  background: rgba(180, 121, 0, 0.18);
  color: #d49500;
}

.detail-pendaftar-status--waiting i {
  background: #d49500;
}

.detail-pendaftar-status--accepted {
  background: rgba(22, 163, 74, 0.16);
  color: #22c55e;
}

.detail-pendaftar-status--accepted i {
  background: #22c55e;
}

.detail-pendaftar-status--rejected {
  background: rgba(220, 38, 38, 0.15);
  color: #ef4444;
}

.detail-pendaftar-status--rejected i {
  background: #ef4444;
}

.detail-pendaftar-card {
  margin-top: 16px;
  padding: 20px 22px 22px;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
}

.detail-pendaftar-card__title {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 20px;
  margin-bottom: 18px;
  color: #c77b84;
}

.detail-pendaftar-card__title h3 {
  margin: 0;
  color: #f3f6fa;
  font-size: 13px;
  font-weight: 700;
  line-height: 18px;
}

.detail-pendaftar-info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 50px;
  row-gap: 20px;
}

.detail-pendaftar-info-grid--game {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 32px;
}

.detail-pendaftar-info {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.detail-pendaftar-info span {
  color: #758198;
  font-size: 9px;
  font-weight: 500;
  line-height: 13px;
  letter-spacing: 0.15px;
}

.detail-pendaftar-info strong {
  margin-top: 5px;
  overflow: hidden;
  color: #e9edf4;
  font-size: 11px;
  font-weight: 600;
  line-height: 16px;
  text-overflow: ellipsis;
}

.detail-pendaftar-motivation {
  padding: 15px 16px;
  border: 1px solid #253149;
  border-radius: 9px;
  background: #0d1422;
  color: #a9b4c7;
  font-size: 10px;
  font-weight: 400;
  line-height: 18px;
}

.detail-pendaftar-card--documents {
  padding-bottom: 20px;
}

.detail-pendaftar-documents {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.detail-document {
  overflow: hidden;
  border: 1px solid #253149;
  border-radius: 10px;
  background: #0d1422;
}

.detail-document__head {
  display: flex;
  min-height: 58px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 10px 14px;
  border-bottom: 1px solid #253149;
}

.detail-document__head > div {
  min-width: 0;
}

.detail-document__head h4 {
  margin: 0;
  overflow: hidden;
  color: #e9edf4;
  font-size: 10px;
  font-weight: 700;
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-document__head p {
  margin: 3px 0 0;
  overflow: hidden;
  color: #647087;
  font-size: 8px;
  line-height: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-document__head > span {
  flex: 0 0 auto;
  color: #647087;
  font-size: 8px;
}

.detail-document__preview {
  position: relative;
  height: 164px;
  margin: 12px 12px 0;
  overflow: hidden;
  border: 1px solid #26334a;
  border-radius: 7px;
  background: #121b2c;
}

.detail-document__preview--ktm {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px;
  background:
    linear-gradient(135deg, rgba(15, 79, 131, 0.94), rgba(16, 38, 70, 0.96) 48%, rgba(207, 37, 53, 0.94));
}

.detail-document__ktm-mark {
  display: grid;
  width: 74px;
  height: 92px;
  flex: 0 0 74px;
  place-items: center;
  border-radius: 4px;
  background: #eceff3;
  color: #12375e;
  font-size: 13px;
  font-weight: 800;
  box-shadow: 0 3px 14px rgba(0, 0, 0, 0.25);
}

.detail-document__preview--ktm > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 7px;
  min-width: 0;
}

.detail-document__preview--ktm strong {
  overflow: hidden;
  color: #fff;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-document__preview--ktm span {
  color: rgba(255, 255, 255, 0.8);
  font-size: 8px;
}

.detail-document__preview--instagram {
  padding: 14px;
  background:
    radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.16), transparent 24%),
    linear-gradient(145deg, #e6e1d6 0 36%, #222a36 36% 52%, #0a0d12 52% 100%);
}

.detail-document__screenbar {
  width: 62%;
  height: 10px;
  margin-bottom: 12px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.82);
}

.detail-document__screenbody {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  height: 112px;
}

.detail-document__screenbody span {
  display: block;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.12);
}

.detail-document__screenbody span:first-child {
  grid-row: span 2;
  background: rgba(255, 255, 255, 0.25);
}

.detail-document__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 10px 12px 12px;
}

.detail-document__actions button {
  height: 31px;
  border: 1px solid #2a3750;
  border-radius: 6px;
  background: #141e30;
  color: #8d99ae;
  font-size: 9px;
  font-weight: 600;
  cursor: pointer;
}

.detail-document__actions button:first-child {
  border-color: rgba(22, 163, 74, 0.35);
  background: rgba(22, 163, 74, 0.18);
  color: #24c35d;
}

.detail-document__actions button:hover {
  filter: brightness(1.1);
}

.detail-pendaftar-review {
  display: flex;
  min-height: 72px;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 16px;
  padding: 14px 18px;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
}

.detail-pendaftar-review > div:first-child {
  display: flex;
  align-items: center;
  gap: 8px;
}

.detail-pendaftar-review > div:first-child > span {
  color: #758198;
  font-size: 10px;
}

.detail-pendaftar-review__status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  font-weight: 600;
}

.detail-pendaftar-review__status--waiting {
  color: #d49500;
}

.detail-pendaftar-review__status--waiting i {
  background: #d49500;
}

.detail-pendaftar-review__status--accepted {
  color: #22c55e;
}

.detail-pendaftar-review__status--accepted i {
  background: #22c55e;
}

.detail-pendaftar-review__status--rejected {
  color: #ef4444;
}

.detail-pendaftar-review__status--rejected i {
  background: #ef4444;
}

.detail-pendaftar-review__actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.detail-pendaftar-reject,
.detail-pendaftar-accept {
  min-width: 116px;
  height: 38px;
  border-radius: 8px;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
}

.detail-pendaftar-reject {
  border: 1px solid rgba(227, 27, 45, 0.52);
  background: transparent;
  color: #e45562;
}

.detail-pendaftar-accept {
  border: 1px solid #e31b2d;
  background: #e31b2d;
  color: #fff;
  box-shadow: 0 7px 18px rgba(227, 27, 45, 0.18);
}

@media (max-width: 980px) {
  .detail-pendaftar-content {
    padding-right: 20px;
    padding-left: 20px;
  }

  .detail-pendaftar-info-grid--game {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .detail-pendaftar-documents {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .detail-pendaftar-page {
    flex-direction: column;
  }

  .detail-pendaftar-main {
    width: 100%;
    margin-left: 0;
  }

  .detail-pendaftar-content {
    padding: 18px;
  }

  .detail-pendaftar-hero,
  .detail-pendaftar-review {
    align-items: flex-start;
    flex-direction: column;
  }

  .detail-pendaftar-info-grid,
  .detail-pendaftar-info-grid--game {
    grid-template-columns: 1fr;
  }

  .detail-pendaftar-review__actions {
    width: 100%;
  }

  .detail-pendaftar-reject,
  .detail-pendaftar-accept {
    flex: 1;
  }
}

/* Detail Pendaftar document controls from Figma */
.detail-document__view-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 10px 12px 0;
}

.detail-document__view-actions button {
  display: inline-flex;
  height: 31px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid #253149;
  border-radius: 6px;
  background: #141e30;
  color: #a9b4c7;
  font-size: 9px;
  font-weight: 600;
  cursor: pointer;
}

.detail-document__view-actions button:hover {
  border-color: #33415c;
  color: #e7ebf2;
}

.detail-document__actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}


/* ===== Anggota — matched to Figma frame "Anggota" (63:1471) ===== */
.anggota-page {
  display: flex;
  width: 100%;
  min-height: 100svh;
  background: #080d18;
  color: #f8fafc;
}

.anggota-main {
  width: calc(100% - 256px);
  min-height: 100svh;
  margin-left: 256px;
  background: #080d18;
}

.anggota-content {
  padding: 32px;
}

.anggota-summary {
  display: grid;
  grid-template-columns: 1.1fr 1.15fr 1fr;
  gap: 18px;
}

.anggota-stat {
  min-height: 146px;
  padding: 20px;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
}

.anggota-stat--total {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.anggota-stat p {
  margin: 0;
  color: #758198;
  font-size: 10px;
  font-weight: 700;
  line-height: 14px;
  letter-spacing: 1px;
}

.anggota-stat__value {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-top: 22px;
}

.anggota-stat__value strong {
  color: #f8fafc;
  font-size: 29px;
  font-weight: 700;
  line-height: 32px;
}

.anggota-stat__value span {
  color: #a9b4c7;
  font-size: 11px;
}

.anggota-stat small {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: 14px;
  color: #758198;
  font-size: 9px;
  line-height: 12px;
}

.anggota-stat small i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #23c55e;
  box-shadow: 0 0 0 3px rgba(35, 197, 94, 0.08);
}

.anggota-stat__icon {
  display: grid;
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  place-items: center;
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.03);
  color: #8d99ae;
}

.anggota-stat__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.anggota-stat__head svg {
  color: #758198;
}

.anggota-game-grid,
.anggota-cohort-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px 18px;
  margin-top: 18px;
}

.anggota-game-grid div,
.anggota-cohort-grid div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-width: 0;
}

.anggota-game-grid span,
.anggota-cohort-grid span {
  overflow: hidden;
  color: #a9b4c7;
  font-size: 10px;
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.anggota-game-grid b,
.anggota-cohort-grid b {
  display: inline-flex;
  min-width: 32px;
  height: 22px;
  align-items: center;
  justify-content: center;
  padding: 0 6px;
  border-radius: 5px;
  background: #172236;
  color: #a9b4c7;
  font-size: 10px;
  font-weight: 700;
}

.anggota-number--blue {
  color: #6fc6f0 !important;
}

.anggota-number--red {
  color: #ef5b67 !important;
}

.anggota-number--yellow {
  color: #e7b23f !important;
}

.anggota-number--cyan {
  color: #7ad4e8 !important;
}

.anggota-filter {
  display: grid;
  grid-template-columns: minmax(320px, 1.7fr) minmax(150px, 0.7fr) minmax(165px, 0.8fr) 112px;
  gap: 12px;
  min-height: 76px;
  align-items: center;
  margin-top: 18px;
  padding: 14px 16px;
  border: 1px solid #1f2a3d;
  border-radius: 14px;
  background: #111a2b;
}

.anggota-search {
  position: relative;
  display: flex;
  height: 46px;
  align-items: center;
  border: 1px solid #2a3750;
  border-radius: 10px;
  background: #0d1422;
}

.anggota-search svg {
  position: absolute;
  left: 15px;
  color: #758198;
  pointer-events: none;
}

.anggota-search input {
  width: 100%;
  height: 44px;
  padding: 0 14px 0 43px;
  border: 0;
  outline: 0;
  border-radius: 10px;
  background: transparent;
  color: #f8fafc;
  font-size: 12px;
}

.anggota-search input::placeholder {
  color: #758198;
}

.anggota-filter select {
  width: 100%;
  height: 46px;
  padding: 0 36px 0 14px;
  border: 1px solid #2a3750;
  outline: 0;
  border-radius: 10px;
  background:
    linear-gradient(45deg, transparent 50%, #758198 50%) calc(100% - 18px) 20px / 6px 6px no-repeat,
    linear-gradient(135deg, #758198 50%, transparent 50%) calc(100% - 13px) 20px / 6px 6px no-repeat,
    #0d1422;
  color: #d0d7e3;
  font-size: 11px;
  font-weight: 500;
  appearance: none;
  cursor: pointer;
}

.anggota-reset {
  height: 46px;
  border: 1px solid #2a3750;
  border-radius: 10px;
  background: #0d1422;
  color: #a9b4c7;
  font-size: 11px;
  font-weight: 500;
  cursor: pointer;
}

.anggota-search:focus-within,
.anggota-filter select:focus {
  border-color: #3a4966;
}

.anggota-table-card {
  margin-top: 18px;
  overflow: hidden;
  border: 1px solid #1f2a3d;
  border-radius: 14px;
  background: #111a2b;
}

.anggota-table-scroll {
  width: 100%;
  overflow-x: auto;
}

.anggota-table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
}

.anggota-table th,
.anggota-table td {
  height: 58px;
  padding: 0 18px;
  border-bottom: 1px solid #1f2a3d;
  text-align: left;
  vertical-align: middle;
  white-space: nowrap;
}

.anggota-table th {
  height: 52px;
  color: #758198;
  font-size: 9px;
  font-weight: 700;
  line-height: 12px;
  letter-spacing: 0.65px;
}

.anggota-table td {
  color: #8e9aaf;
  font-size: 10px;
  line-height: 14px;
}

.anggota-table th:nth-child(1),
.anggota-table td:nth-child(1) { width: 24%; }

.anggota-table th:nth-child(2),
.anggota-table td:nth-child(2) { width: 11%; }

.anggota-table th:nth-child(3),
.anggota-table td:nth-child(3) { width: 25%; }

.anggota-table th:nth-child(4),
.anggota-table td:nth-child(4) { width: 16%; }

.anggota-table th:nth-child(5),
.anggota-table td:nth-child(5) { width: 12%; }

.anggota-table th:nth-child(6),
.anggota-table td:nth-child(6) {
  width: 12%;
  text-align: right;
}

.anggota-person {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12px;
}

.anggota-person__avatar {
  display: grid;
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  place-items: center;
  border-radius: 50%;
  background: #182237;
  color: #eef2f7;
  font-size: 10px;
  font-weight: 700;
}

.anggota-person > div {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.anggota-person strong {
  overflow: hidden;
  color: #f3f6fa;
  font-size: 11px;
  font-weight: 700;
  line-height: 15px;
  text-overflow: ellipsis;
}

.anggota-person span:not(.anggota-person__avatar) {
  margin-top: 2px;
  overflow: hidden;
  color: #758198;
  font-size: 9px;
  line-height: 12px;
  text-overflow: ellipsis;
}

.anggota-detail {
  display: inline-flex;
  min-width: 64px;
  height: 32px;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 0 10px;
  border: 1px solid #253149;
  border-radius: 7px;
  background: #172236;
  color: #a9b4c7;
  font-size: 10px;
  font-weight: 500;
  cursor: pointer;
}

.anggota-pagination {
  display: flex;
  min-height: 64px;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 0 20px;
}

.anggota-pagination p {
  margin: 0;
  color: #758198;
  font-size: 11px;
}

.anggota-pagination p strong {
  color: #dfe5ee;
}

@media (max-width: 1100px) {
  .anggota-summary {
    grid-template-columns: 1fr 1fr;
  }

  .anggota-stat--cohort {
    grid-column: 1 / -1;
  }

  .anggota-filter {
    grid-template-columns: 1fr 1fr;
  }

  .anggota-table {
    min-width: 920px;
  }
}

@media (max-width: 760px) {
  .anggota-page {
    flex-direction: column;
  }

  .anggota-main {
    width: 100%;
    margin-left: 0;
  }

  .anggota-content {
    padding: 18px;
  }

  .anggota-summary,
  .anggota-filter {
    grid-template-columns: 1fr;
  }

  .anggota-stat--cohort {
    grid-column: auto;
  }

  .anggota-pagination {
    align-items: flex-start;
    flex-direction: column;
    padding: 14px 16px 18px;
  }
}


/* UI icon assets supplied by user */
.ui-nav-icon {
  display: block;
  width: 17px;
  height: 17px;
  flex: 0 0 17px;
  object-fit: contain;
}

.ui-nav-icon--pendaftar {
  width: 18px;
  height: 18px;
  flex-basis: 18px;
}

.ui-nav-icon--anggota {
  width: 18px;
  height: 18px;
  flex-basis: 18px;
}

.detail-pendaftar-card__title .ui-section-icon {
  display: block;
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  object-fit: contain;
}

.detail-pendaftar-card__title .ui-section-icon--game {
  width: 19px;
  height: 17px;
}

.detail-pendaftar-card__title .ui-section-icon--motivation {
  width: 19px;
  height: 16px;
}

.detail-pendaftar-card__title .ui-section-icon--document {
  width: 19px;
  height: 17px;
}

.anggota-stat__asset {
  display: block;
  object-fit: contain;
}

.anggota-stat__asset--members {
  width: 22px;
  height: 18px;
}

.anggota-stat__asset--game {
  width: 22px;
  height: 18px;
}

.anggota-stat__asset--cohort {
  width: 22px;
  height: 18px;
}


/* ===== Detail Anggota — matched to Figma frame "Detail Anggota" ===== */
.detail-anggota-page {
  display: flex;
  width: 100%;
  min-height: 100svh;
  background: #080d18;
  color: #f8fafc;
}

.detail-anggota-main {
  width: calc(100% - 256px);
  min-height: 100svh;
  margin-left: 256px;
  background: #080d18;
}

.detail-anggota-content {
  width: 100%;
  max-width: 1024px;
  margin: 0 auto;
  padding: 28px 32px 36px;
}

.detail-anggota-back {
  display: inline-flex;
  height: 32px;
  align-items: center;
  gap: 7px;
  margin-bottom: 18px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #8d99ae;
  font-family: Inter, sans-serif;
  font-size: 11px;
  font-weight: 500;
  line-height: 16px;
  cursor: pointer;
}

.detail-anggota-back:hover {
  color: #e8edf5;
}

.detail-anggota-hero {
  display: flex;
  min-height: 96px;
  align-items: center;
  padding: 20px 24px;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.08);
}

.detail-anggota-hero__title-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.detail-anggota-hero h2 {
  margin: 0;
  color: #f8fafc;
  font-family: Inter, sans-serif;
  font-size: 20px;
  font-weight: 700;
  line-height: 26px;
  letter-spacing: -0.2px;
}

.detail-anggota-hero__id {
  display: inline-flex;
  height: 22px;
  align-items: center;
  padding: 0 8px;
  border: 1px solid #253149;
  border-radius: 5px;
  background: #172236;
  color: #758198;
  font-family: "Liberation Mono", monospace;
  font-size: 9px;
  font-weight: 400;
  line-height: 12px;
}

.detail-anggota-hero p {
  margin: 5px 0 0;
  color: #758198;
  font-family: Inter, sans-serif;
  font-size: 11px;
  font-weight: 400;
  line-height: 16px;
}

.detail-anggota-card {
  margin-top: 16px;
  padding: 20px 22px 22px;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
}

.detail-anggota-card__title {
  display: flex;
  min-height: 20px;
  align-items: center;
  gap: 8px;
  margin-bottom: 18px;
}

.detail-anggota-card__title h3 {
  margin: 0;
  color: #f3f6fa;
  font-family: Inter, sans-serif;
  font-size: 13px;
  font-weight: 700;
  line-height: 18px;
}

.detail-anggota-card__title .ui-section-icon {
  display: block;
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  object-fit: contain;
}

.detail-anggota-card__title .ui-section-icon--game {
  width: 19px;
  height: 17px;
}

.detail-anggota-card__title .ui-section-icon--motivation {
  width: 19px;
  height: 16px;
}

.detail-anggota-card__title .ui-section-icon--document {
  width: 19px;
  height: 17px;
}

.detail-anggota-info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 50px;
  row-gap: 20px;
}

.detail-anggota-info-grid--game {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 32px;
}

.detail-anggota-info {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.detail-anggota-info span {
  color: #758198;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 500;
  line-height: 13px;
  letter-spacing: 0.15px;
}

.detail-anggota-info strong {
  margin-top: 5px;
  overflow: hidden;
  color: #e9edf4;
  font-family: Inter, sans-serif;
  font-size: 11px;
  font-weight: 600;
  line-height: 16px;
  text-overflow: ellipsis;
}

.detail-anggota-info__regular {
  font-weight: 400 !important;
}

.detail-anggota-mono {
  font-family: "Liberation Mono", monospace !important;
  font-weight: 700 !important;
}

.detail-anggota-motivation {
  padding: 15px 16px;
  border: 1px solid #253149;
  border-radius: 9px;
  background: #0d1422;
  color: #a9b4c7;
  font-family: Inter, sans-serif;
  font-size: 10px;
  font-style: italic;
  font-weight: 400;
  line-height: 18px;
}

.detail-anggota-card--documents {
  padding-bottom: 20px;
}

.detail-anggota-documents {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.detail-anggota-document {
  overflow: hidden;
  border: 1px solid #253149;
  border-radius: 10px;
  background: #0d1422;
}

.detail-anggota-document__head {
  display: flex;
  min-height: 58px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 10px 14px;
  border-bottom: 1px solid #253149;
}

.detail-anggota-document__head > div {
  min-width: 0;
}

.detail-anggota-document__head h4 {
  margin: 0;
  overflow: hidden;
  color: #e9edf4;
  font-family: Inter, sans-serif;
  font-size: 10px;
  font-weight: 700;
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-anggota-document__head p {
  margin: 3px 0 0;
  overflow: hidden;
  color: #647087;
  font-family: "Liberation Mono", monospace;
  font-size: 8px;
  font-weight: 400;
  line-height: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-anggota-document__head > span {
  flex: 0 0 auto;
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 500;
}

.detail-anggota-document__preview {
  position: relative;
  height: 164px;
  margin: 12px 12px 0;
  overflow: hidden;
  border: 1px solid #26334a;
  border-radius: 7px;
  background: #121b2c;
}

.detail-anggota-document__preview--ktm {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px;
  background:
    linear-gradient(135deg, rgba(15, 79, 131, 0.94), rgba(16, 38, 70, 0.96) 48%, rgba(207, 37, 53, 0.94));
}

.detail-anggota-document__ktm-mark {
  display: grid;
  width: 74px;
  height: 92px;
  flex: 0 0 74px;
  place-items: center;
  border-radius: 4px;
  background: #eceff3;
  color: #12375e;
  font-family: Inter, sans-serif;
  font-size: 13px;
  font-weight: 800;
  box-shadow: 0 3px 14px rgba(0, 0, 0, 0.25);
}

.detail-anggota-document__preview--ktm > div:last-child {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 7px;
}

.detail-anggota-document__preview--ktm strong {
  overflow: hidden;
  color: #fff;
  font-family: Inter, sans-serif;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-anggota-document__preview--ktm span {
  color: rgba(255, 255, 255, 0.8);
  font-family: Inter, sans-serif;
  font-size: 8px;
}

.detail-anggota-document__preview--instagram {
  padding: 14px;
  background:
    radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.16), transparent 24%),
    linear-gradient(145deg, #e6e1d6 0 36%, #222a36 36% 52%, #0a0d12 52% 100%);
}

.detail-anggota-document__screenbar {
  width: 62%;
  height: 10px;
  margin-bottom: 12px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.82);
}

.detail-anggota-document__screenbody {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  height: 112px;
}

.detail-anggota-document__screenbody span {
  display: block;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.12);
}

.detail-anggota-document__screenbody span:first-child {
  grid-row: span 2;
  background: rgba(255, 255, 255, 0.25);
}

.detail-anggota-document__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  padding: 10px 12px 12px;
}

.detail-anggota-document__actions button {
  display: inline-flex;
  height: 31px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid #253149;
  border-radius: 6px;
  background: #141e30;
  color: #a9b4c7;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 500;
  cursor: pointer;
}

.detail-anggota-document__actions button:hover {
  border-color: #33415c;
  color: #e7ebf2;
}

.detail-anggota-actions {
  display: flex;
  min-height: 72px;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16px;
  padding: 14px 18px;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.08);
}

.detail-anggota-delete {
  min-width: 132px;
  height: 38px;
  border: 1px solid #e31b2d;
  border-radius: 8px;
  background: #e31b2d;
  color: #fff;
  font-family: Inter, sans-serif;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 7px 18px rgba(227, 27, 45, 0.18);
}

.detail-anggota-delete:hover {
  filter: brightness(1.08);
}

@media (max-width: 980px) {
  .detail-anggota-content {
    padding-right: 20px;
    padding-left: 20px;
  }

  .detail-anggota-info-grid--game {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .detail-anggota-documents {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .detail-anggota-page {
    flex-direction: column;
  }

  .detail-anggota-main {
    width: 100%;
    margin-left: 0;
  }

  .detail-anggota-content {
    padding: 18px;
  }

  .detail-anggota-hero {
    min-height: auto;
    padding: 18px;
  }

  .detail-anggota-hero__title-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 7px;
  }

  .detail-anggota-info-grid,
  .detail-anggota-info-grid--game {
    grid-template-columns: 1fr;
  }

  .detail-anggota-documents {
    grid-template-columns: 1fr;
  }

  .detail-anggota-actions {
    padding: 14px;
  }

  .detail-anggota-delete {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .detail-anggota-card {
    padding: 18px 16px 20px;
  }

  .detail-anggota-document__head {
    align-items: flex-start;
  }

  .detail-anggota-document__preview {
    height: 150px;
  }

  .detail-anggota-document__preview--ktm {
    padding: 15px;
  }

  .detail-anggota-document__ktm-mark {
    width: 62px;
    height: 80px;
    flex-basis: 62px;
  }
}


/* ===== Kelola Konten / Konten Beranda ===== */
.konten-page {
  display: flex;
  width: 100%;
  min-height: 100svh;
  background: #080d18;
  color: #f8fafc;
}

.konten-main {
  width: calc(100% - 256px);
  min-height: 100svh;
  margin-left: 256px;
  background: #080d18;
}

.konten-content {
  padding: 32px;
}

.konten-nav-icon {
  display: block;
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  object-fit: contain;
}

.konten-tabs {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  padding: 3px;
  margin-bottom: 24px;
  border-radius: 9px;
  background: #111a2b;
}

.konten-tab {
  display: inline-flex;
  height: 34px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 13px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #8d99ae;
  font-family: Inter, sans-serif;
  font-size: 11px;
  font-weight: 600;
  line-height: 14px;
  white-space: nowrap;
  cursor: pointer;
}

.konten-tab--active {
  background: #e31b2d;
  color: #ffffff;
  box-shadow: 0 5px 14px rgba(227, 27, 45, 0.22);
}

.konten-card {
  margin-top: 18px;
  padding: 20px 22px;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
}

.konten-card:first-of-type {
  margin-top: 0;
}

.konten-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.konten-card__head--compact {
  align-items: center;
}

.konten-card__heading {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 11px;
}

.konten-section-icon {
  display: block;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  object-fit: contain;
}

.konten-section-icon--hero,
.konten-section-icon--stats {
  width: 30px;
  height: 30px;
  flex-basis: 30px;
}

.konten-card__heading h2 {
  margin: 0;
  color: #f3f6fa;
  font-family: Inter, sans-serif;
  font-size: 13px;
  font-weight: 700;
  line-height: 18px;
}

.konten-card__heading p {
  margin: 2px 0 0;
  color: #758198;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 400;
  line-height: 13px;
}

.konten-switch-row {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 9px;
  color: #8d99ae;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 500;
  line-height: 13px;
  cursor: pointer;
}

.konten-switch-row input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.konten-switch-row i {
  position: relative;
  display: block;
  width: 34px;
  height: 19px;
  border-radius: 999px;
  background: #344158;
  transition: background 0.18s ease;
}

.konten-switch-row i::after {
  content: "";
  position: absolute;
  top: 3px;
  left: 3px;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: #ffffff;
  transition: transform 0.18s ease;
}

.konten-switch-row input:checked + i {
  background: #20c565;
}

.konten-switch-row input:checked + i::after {
  transform: translateX(15px);
}

.konten-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(270px, 0.75fr);
  gap: 24px;
  margin-top: 20px;
}

.konten-form-stack {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.konten-field,
.konten-stat-field {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.konten-field > span,
.konten-stat-field > span,
.konten-banner-control__label {
  margin-bottom: 6px;
  color: #8d99ae;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 600;
  line-height: 13px;
}

.konten-field input,
.konten-field textarea,
.konten-stat-field input {
  width: 100%;
  border: 1px solid #18243a;
  outline: 0;
  border-radius: 8px;
  background: #0d1422;
  color: #e8edf5;
  font-family: Inter, sans-serif;
  font-size: 10px;
  font-weight: 400;
}

.konten-field input {
  height: 37px;
  padding: 0 12px;
}

.konten-field textarea {
  min-height: 70px;
  padding: 10px 12px;
  resize: vertical;
  line-height: 17px;
}

.konten-field input:focus,
.konten-field textarea:focus,
.konten-stat-field input:focus {
  border-color: #34445f;
}

.konten-banner-control {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.konten-banner-preview {
  position: relative;
  min-height: 173px;
  overflow: hidden;
  border: 1px solid #253149;
  border-radius: 9px;
  background:
    radial-gradient(circle at 72% 28%, rgba(227, 27, 45, 0.28), transparent 31%),
    linear-gradient(135deg, #121c30 0%, #0c111c 58%, #1d0f18 100%);
}

.konten-banner-preview__glow {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(122deg, transparent 22%, rgba(227, 27, 45, 0.17) 22.5% 23.8%, transparent 24.2%),
    linear-gradient(58deg, transparent 55%, rgba(91, 149, 255, 0.12) 55.5% 57%, transparent 57.5%);
  pointer-events: none;
}

.konten-banner-preview__screen {
  position: absolute;
  top: 22px;
  right: 27px;
  display: flex;
  width: 118px;
  height: 68px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(227, 27, 45, 0.65);
  border-radius: 4px;
  background: rgba(13, 20, 34, 0.82);
  box-shadow: 0 0 22px rgba(227, 27, 45, 0.24);
  transform: perspective(240px) rotateY(-8deg);
}

.konten-banner-preview__screen span {
  color: #e31b2d;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.6px;
}

.konten-banner-preview__screen strong {
  margin-top: 2px;
  color: #ffffff;
  font-family: Inter, sans-serif;
  font-size: 12px;
  font-weight: 800;
}

.konten-banner-preview__stage {
  position: absolute;
  right: 11px;
  bottom: 45px;
  left: 11px;
  height: 43px;
  border-radius: 3px;
  background:
    linear-gradient(90deg, rgba(226, 38, 54, 0.45), transparent 14% 86%, rgba(226, 38, 54, 0.45)),
    linear-gradient(180deg, rgba(68, 91, 125, 0.34), rgba(8, 13, 24, 0.86));
  transform: perspective(220px) rotateX(13deg);
}

.konten-banner-preview__meta {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: 41px;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 7px 9px;
  background: rgba(7, 11, 20, 0.89);
}

.konten-banner-preview__meta > div {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.konten-banner-preview__meta strong {
  overflow: hidden;
  color: #e8edf5;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 600;
  line-height: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.konten-banner-preview__meta span {
  margin-top: 1px;
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 7px;
  line-height: 10px;
}

.konten-banner-preview__meta button {
  display: inline-flex;
  height: 25px;
  flex: 0 0 auto;
  align-items: center;
  gap: 5px;
  padding: 0 8px;
  border: 1px solid #334159;
  border-radius: 6px;
  background: #172236;
  color: #d5dbe6;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 600;
  cursor: pointer;
}

.konten-help {
  margin: 7px 0 0;
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 8px;
  line-height: 12px;
}

.konten-card__footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 17px;
}

.konten-save-button,
.konten-secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 0;
  font-family: Inter, sans-serif;
  font-weight: 600;
  cursor: pointer;
}

.konten-save-button {
  height: 31px;
  padding: 0 12px;
  border-radius: 7px;
  background: #e31b2d;
  color: #ffffff;
  font-size: 9px;
  box-shadow: 0 6px 15px rgba(227, 27, 45, 0.18);
}

.konten-save-button__check {
  display: grid;
  width: 13px;
  height: 13px;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  font-size: 8px;
  line-height: 1;
}

.konten-secondary-button {
  height: 29px;
  padding: 0 10px;
  border: 1px solid #253149;
  border-radius: 7px;
  background: #172236;
  color: #c7cfdb;
  font-size: 9px;
}

.konten-stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-top: 18px;
}

.konten-stat-field {
  padding: 10px 11px;
  border-radius: 8px;
  background: #0d1422;
}

.konten-stat-field > span {
  margin-bottom: 5px;
}

.konten-stat-field input {
  height: 29px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #f8fafc;
  font-size: 18px;
  font-weight: 700;
}

.konten-stat-field small {
  margin-top: 4px;
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 400;
  line-height: 11px;
}

.konten-feature-list,
.konten-game-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 17px;
}

.konten-feature-row {
  display: flex;
  min-height: 54px;
  align-items: center;
  gap: 11px;
  padding: 8px 10px;
  border-radius: 9px;
  background: #0d1422;
}

.konten-feature-row > img {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  object-fit: contain;
}

.konten-feature-row > div {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.konten-feature-row strong {
  color: #e8edf5;
  font-family: Inter, sans-serif;
  font-size: 10px;
  font-weight: 700;
  line-height: 14px;
}

.konten-feature-row > div span {
  margin-top: 2px;
  overflow: hidden;
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 8px;
  line-height: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.konten-active-badge,
.konten-show-badge {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: rgba(22, 163, 74, 0.18);
  color: #22c55e;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 700;
}

.konten-active-badge {
  min-width: 38px;
  height: 20px;
}

.konten-heading-with-badge {
  display: flex;
  align-items: center;
  gap: 8px;
}

.konten-heading-with-badge > span {
  display: inline-flex;
  height: 20px;
  align-items: center;
  padding: 0 8px;
  border-radius: 999px;
  background: rgba(227, 27, 45, 0.15);
  color: #e26c78;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 700;
}

.konten-game-row {
  display: grid;
  grid-template-columns: 24px 39px minmax(180px, 1fr) 45px 48px 74px;
  min-height: 53px;
  align-items: center;
  gap: 8px;
  padding: 7px 10px;
  border-radius: 9px;
  background: #0d1422;
}

.konten-game-order {
  color: #758198;
  font-family: Inter, sans-serif;
  font-size: 15px;
  font-weight: 600;
  text-align: center;
}

.konten-game-code {
  display: grid;
  width: 36px;
  height: 33px;
  place-items: center;
  border-radius: 7px;
  background: #172236;
  color: #d6dde8;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 700;
}

.konten-game-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.konten-game-copy strong {
  overflow: hidden;
  color: #f1f4f8;
  font-family: Inter, sans-serif;
  font-size: 10px;
  font-weight: 700;
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.konten-game-copy span {
  margin-top: 2px;
  overflow: hidden;
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 8px;
  line-height: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.konten-show-badge {
  min-width: 38px;
  height: 20px;
}

.konten-order-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1px;
}

.konten-order-actions button {
  display: grid;
  width: 21px;
  height: 25px;
  place-items: center;
  border: 0;
  background: transparent;
  color: #8d99ae;
  cursor: pointer;
}

.konten-order-actions button:disabled {
  opacity: 0.28;
  cursor: default;
}

.konten-hide-button {
  height: 25px;
  padding: 0 9px;
  border: 0;
  border-radius: 6px;
  background: #172236;
  color: #8d99ae;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 600;
  cursor: pointer;
}

.konten-note {
  display: flex;
  align-items: flex-start;
  gap: 5px;
  margin: 11px 0 0;
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 8px;
  line-height: 12px;
}

.konten-card--event-preview {
  min-height: 76px;
}

@media (max-width: 1050px) {
  .konten-hero-grid {
    grid-template-columns: 1fr;
  }

  .konten-banner-control {
    max-width: 520px;
  }

  .konten-game-row {
    grid-template-columns: 24px 39px minmax(170px, 1fr) 45px 48px 74px;
    min-width: 680px;
  }

  .konten-game-list {
    overflow-x: auto;
  }
}

@media (max-width: 820px) {
  .konten-stat-grid {
    grid-template-columns: 1fr;
  }

  .konten-card__head {
    align-items: flex-start;
    flex-direction: column;
  }

  .konten-switch-row,
  .konten-secondary-button {
    align-self: flex-end;
  }
}

@media (max-width: 760px) {
  .konten-page {
    flex-direction: column;
  }

  .konten-main {
    width: 100%;
    margin-left: 0;
  }

  .konten-content {
    padding: 18px;
  }

  .konten-tabs {
    display: flex;
    max-width: 100%;
    overflow-x: auto;
    margin-bottom: 18px;
  }

  .konten-tab {
    flex: 0 0 auto;
  }

  .konten-card {
    margin-top: 14px;
    padding: 16px;
  }

  .konten-hero-grid {
    gap: 18px;
  }

  .konten-feature-row > div span {
    white-space: normal;
  }
}

@media (max-width: 480px) {
  .konten-content {
    padding: 14px;
  }

  .konten-card__heading {
    align-items: flex-start;
  }

  .konten-section-icon {
    width: 30px;
    height: 30px;
    flex-basis: 30px;
  }

  .konten-card__footer {
    justify-content: stretch;
  }

  .konten-save-button {
    width: 100%;
  }

  .konten-banner-preview {
    min-height: 160px;
  }

  .konten-feature-row {
    align-items: flex-start;
  }

  .konten-active-badge {
    margin-top: 4px;
  }
}


/* Konten Beranda responsive refinements */
.konten-page,
.konten-main,
.konten-content,
.konten-card,
.konten-hero-grid,
.konten-form-stack,
.konten-banner-control {
  min-width: 0;
}

.konten-content {
  overflow-x: hidden;
}

.konten-field input,
.konten-field textarea,
.konten-stat-field input {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

@media (max-width: 760px) {
  .konten-card__head {
    width: 100%;
  }

  .konten-switch-row {
    align-self: flex-start;
    max-width: 100%;
  }

  .konten-banner-control,
  .konten-banner-preview {
    width: 100%;
    max-width: 100%;
  }

  .konten-banner-preview__meta {
    gap: 6px;
  }

  .konten-banner-preview__meta button {
    padding-inline: 7px;
  }
}

@media (max-width: 480px) {
  .konten-content {
    width: 100%;
    box-sizing: border-box;
  }

  .konten-card {
    width: 100%;
    box-sizing: border-box;
  }

  .konten-switch-row {
    width: 100%;
    justify-content: space-between;
  }

  .konten-banner-preview__meta {
    align-items: flex-start;
    flex-direction: column;
  }

  .konten-banner-preview__meta button {
    align-self: stretch;
    justify-content: center;
  }
}


/* ===== Edit Konten Beranda Keunggulan ===== */
.keunggulan-page {
  display: flex;
  width: 100%;
  min-height: 100svh;
  background: #080d18;
  color: #f8fafc;
}

.keunggulan-main {
  width: calc(100% - 256px);
  min-height: 100svh;
  margin-left: 256px;
  background: #080d18;
}

.keunggulan-content {
  padding: 32px;
}

.keunggulan-page-title {
  margin: 2px 0 20px;
  color: #f8fafc;
  font-family: Inter, sans-serif;
  font-size: 22px;
  font-weight: 800;
  line-height: 28px;
  letter-spacing: -0.35px;
}

.keunggulan-layout {
  display: grid;
  grid-template-columns: minmax(330px, 0.86fr) minmax(500px, 1.35fr);
  gap: 18px;
  align-items: start;
}

.keunggulan-list-card,
.keunggulan-form-card {
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.08);
}

.keunggulan-list-card {
  padding: 18px;
}

.keunggulan-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}

.keunggulan-list-head h3 {
  margin: 0;
  color: #f4f7fb;
  font-family: Inter, sans-serif;
  font-size: 13px;
  font-weight: 700;
  line-height: 18px;
}

.keunggulan-list-head > span {
  display: inline-flex;
  height: 21px;
  align-items: center;
  justify-content: center;
  padding: 0 8px;
  border-radius: 999px;
  background: rgba(227, 27, 45, 0.13);
  color: #e86a76;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 600;
  line-height: 10px;
}

.keunggulan-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.keunggulan-item {
  display: flex;
  width: 100%;
  min-height: 122px;
  align-items: flex-start;
  gap: 12px;
  padding: 13px;
  border: 1px solid #223048;
  border-radius: 11px;
  background: #0d1422;
  color: inherit;
  text-align: left;
  cursor: pointer;
  transition: border-color 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
}

.keunggulan-item:hover {
  border-color: #34425c;
}

.keunggulan-item--active {
  border-color: rgba(227, 27, 45, 0.72);
  background: linear-gradient(180deg, rgba(64, 23, 35, 0.76), rgba(20, 24, 38, 0.98));
  box-shadow: 0 0 0 1px rgba(227, 27, 45, 0.08), 0 9px 26px rgba(227, 27, 45, 0.08);
}

.keunggulan-item > img {
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  object-fit: contain;
}

.keunggulan-item__copy {
  min-width: 0;
  flex: 1;
}

.keunggulan-item__title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.keunggulan-item__title-row strong {
  color: #f1f4f8;
  font-family: Inter, sans-serif;
  font-size: 10px;
  font-weight: 700;
  line-height: 14px;
}

.keunggulan-status {
  display: inline-flex;
  height: 19px;
  flex: 0 0 auto;
  align-items: center;
  padding: 0 7px;
  border-radius: 999px;
  background: rgba(34, 197, 94, 0.16);
  color: #22c55e;
  font-family: Inter, sans-serif;
  font-size: 7px;
  font-weight: 600;
}

.keunggulan-item p {
  display: -webkit-box;
  overflow: hidden;
  margin: 7px 0 12px;
  color: #758198;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 400;
  line-height: 12px;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.keunggulan-item__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 9px;
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 600;
}

.keunggulan-item--active .keunggulan-item__meta span:last-child {
  color: #ef7883;
}

.keunggulan-form-card {
  overflow: hidden;
}

.keunggulan-form-head {
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr) auto;
  align-items: center;
  gap: 11px;
  padding: 17px 20px;
  border-bottom: 1px solid #253149;
}

.keunggulan-form-head__icon {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
}

.keunggulan-form-head__icon img {
  width: 32px;
  height: 32px;
  object-fit: contain;
}

.keunggulan-form-head h3 {
  margin: 0;
  color: #f5f7fb;
  font-family: Inter, sans-serif;
  font-size: 13px;
  font-weight: 700;
  line-height: 18px;
}

.keunggulan-form-head p {
  margin: 3px 0 0;
  color: #758198;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 600;
  line-height: 11px;
}

.keunggulan-editing-badge {
  display: inline-flex;
  height: 22px;
  align-items: center;
  justify-content: center;
  padding: 0 9px;
  border-radius: 5px;
  background: rgba(227, 27, 45, 0.16);
  color: #ef6c79;
  font-family: Inter, sans-serif;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.45px;
}

.keunggulan-form-body {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 20px;
}

.keunggulan-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.keunggulan-field__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.keunggulan-field__label b,
.keunggulan-visibility > span {
  color: #c7cfdb;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 600;
  line-height: 13px;
}

.keunggulan-field__label small {
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 600;
  line-height: 11px;
}

.keunggulan-field input,
.keunggulan-field textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #26344d;
  outline: 0;
  border-radius: 8px;
  background: #0d1422;
  color: #f0f3f8;
  font-family: Inter, sans-serif;
  font-size: 10px;
  font-weight: 400;
  transition: border-color 0.16s ease, box-shadow 0.16s ease;
}

.keunggulan-field input {
  height: 39px;
  padding: 0 12px;
}

.keunggulan-field textarea {
  min-height: 88px;
  padding: 11px 12px;
  line-height: 16px;
  resize: vertical;
}

.keunggulan-field input:focus,
.keunggulan-field textarea:focus {
  border-color: rgba(227, 27, 45, 0.65);
  box-shadow: 0 0 0 2px rgba(227, 27, 45, 0.08);
}

.keunggulan-icon-options {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 8px;
}

.keunggulan-icon-option {
  display: flex;
  min-width: 0;
  height: 71px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 7px 5px;
  border: 1px solid #26344d;
  border-radius: 8px;
  background: #0d1422;
  color: #758198;
  cursor: pointer;
}

.keunggulan-icon-option img {
  display: block;
  width: 25px;
  height: 25px;
  object-fit: contain;
}

.keunggulan-icon-option span {
  overflow: hidden;
  max-width: 100%;
  font-family: Inter, sans-serif;
  font-size: 7px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.keunggulan-icon-option--active {
  border-color: #e31b2d;
  background: rgba(227, 27, 45, 0.08);
  color: #f1a1a8;
  box-shadow: 0 0 0 1px rgba(227, 27, 45, 0.06);
}

.keunggulan-visibility {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 13px 14px;
  border: 1px solid #253149;
  border-radius: 9px;
  background: #0d1422;
}

.keunggulan-visibility label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.keunggulan-visibility input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.keunggulan-visibility i {
  position: relative;
  display: inline-block;
  width: 30px;
  height: 17px;
  flex: 0 0 30px;
  border-radius: 999px;
  background: #313d51;
  transition: background 0.16s ease;
}

.keunggulan-visibility i::after {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: #ffffff;
  content: '';
  transition: transform 0.16s ease;
}

.keunggulan-visibility input:checked + i {
  background: #22c55e;
}

.keunggulan-visibility input:checked + i::after {
  transform: translateX(13px);
}

.keunggulan-visibility label b {
  color: #aab4c5;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 400;
  line-height: 13px;
}

.keunggulan-form-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
  padding: 14px 20px;
  border-top: 1px solid #253149;
  background: rgba(9, 15, 26, 0.36);
}

.keunggulan-reset-button,
.keunggulan-save-button {
  display: inline-flex;
  height: 34px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 13px;
  border-radius: 7px;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 700;
  cursor: pointer;
}

.keunggulan-reset-button {
  border: 1px solid #2a3750;
  background: #131c2d;
  color: #9ca8ba;
}

.keunggulan-save-button {
  border: 1px solid #e31b2d;
  background: #e31b2d;
  color: #ffffff;
  box-shadow: 0 7px 18px rgba(227, 27, 45, 0.2);
}

@media (max-width: 1100px) {
  .keunggulan-layout {
    grid-template-columns: minmax(290px, 0.85fr) minmax(430px, 1.15fr);
  }

  .keunggulan-icon-options {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .keunggulan-layout {
    grid-template-columns: 1fr;
  }

  .keunggulan-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .keunggulan-item {
    min-height: 145px;
  }
}

@media (max-width: 760px) {
  .keunggulan-page {
    flex-direction: column;
  }

  .keunggulan-main {
    width: 100%;
    margin-left: 0;
  }

  .keunggulan-content {
    padding: 18px;
  }

  .keunggulan-page-title {
    font-size: 19px;
    line-height: 25px;
  }

  .keunggulan-list {
    grid-template-columns: 1fr;
  }

  .keunggulan-item {
    min-height: 0;
  }

  .keunggulan-form-head {
    grid-template-columns: 40px minmax(0, 1fr);
  }

  .keunggulan-editing-badge {
    grid-column: 1 / -1;
    justify-self: flex-start;
  }
}

@media (max-width: 520px) {
  .keunggulan-content {
    padding: 14px;
  }

  .keunggulan-list-card {
    padding: 14px;
  }

  .keunggulan-form-body {
    padding: 16px;
  }

  .keunggulan-form-head {
    padding: 15px 16px;
  }

  .keunggulan-icon-options {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .keunggulan-field__label,
  .keunggulan-visibility {
    align-items: flex-start;
    flex-direction: column;
  }

  .keunggulan-form-footer {
    align-items: stretch;
    flex-direction: column-reverse;
    padding: 13px 16px 16px;
  }

  .keunggulan-reset-button,
  .keunggulan-save-button {
    width: 100%;
  }
}


/* ===== Konten Game / Divisi ===== */
.game-divisi-page {
  display: flex;
  width: 100%;
  min-height: 100svh;
  background: #080d18;
  color: #f8fafc;
}

.game-divisi-main {
  width: calc(100% - 256px);
  min-height: 100svh;
  margin-left: 256px;
  background: #080d18;
}

.game-divisi-content {
  padding: 32px;
}

.game-divisi-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
}

.game-divisi-count {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #e7ebf2;
  font-family: Inter, sans-serif;
  font-size: 11px;
  font-weight: 700;
}

.game-divisi-count__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.11);
}

.game-divisi-add {
  display: inline-flex;
  height: 35px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 13px;
  border: 1px solid #e31b2d;
  border-radius: 7px;
  background: #e31b2d;
  color: #fff;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 7px 18px rgba(227, 27, 45, 0.18);
}

.game-divisi-table-card {
  overflow: hidden;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.08);
}

.game-divisi-table-head {
  display: flex;
  min-height: 52px;
  align-items: center;
  gap: 9px;
  padding: 0 18px;
  border-bottom: 1px solid #253149;
}

.game-divisi-table-head img {
  width: 28px;
  height: 28px;
  object-fit: contain;
}

.game-divisi-table-head h2 {
  margin: 0;
  color: #f3f6fa;
  font-family: Inter, sans-serif;
  font-size: 12px;
  font-weight: 700;
  line-height: 17px;
}

.game-divisi-table-wrap {
  width: 100%;
  overflow-x: auto;
}

.game-divisi-table {
  width: 100%;
  min-width: 860px;
  border-collapse: collapse;
  table-layout: fixed;
}

.game-divisi-table thead tr {
  background: #0d1422;
}

.game-divisi-table th {
  padding: 11px 12px;
  border-bottom: 1px solid #253149;
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 7px;
  font-weight: 700;
  line-height: 10px;
  letter-spacing: 0.35px;
  text-align: left;
  vertical-align: middle;
}

.game-divisi-table th:nth-child(1) { width: 72px; }
.game-divisi-table th:nth-child(2) { width: 210px; }
.game-divisi-table th:nth-child(3) { width: 245px; }
.game-divisi-table th:nth-child(4) { width: 118px; }
.game-divisi-table th:nth-child(5) { width: 104px; }
.game-divisi-table th:nth-child(6) { width: 115px; }

.game-divisi-table td {
  padding: 13px 12px;
  border-bottom: 1px solid #202c40;
  vertical-align: middle;
}

.game-divisi-table tbody tr:last-child td {
  border-bottom: 0;
}

.game-divisi-row {
  background: #111a2b;
  transition: background 0.16s ease, box-shadow 0.16s ease;
}

.game-divisi-row--editing {
  background: linear-gradient(90deg, rgba(65, 20, 31, 0.64), rgba(17, 26, 43, 0.96) 42%);
  box-shadow: inset 3px 0 0 #e31b2d;
}

.game-divisi-logo,
.game-divisi-logo-fallback {
  width: 38px;
  height: 38px;
  border-radius: 8px;
}

.game-divisi-logo {
  display: block;
  object-fit: cover;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.26);
}

.game-divisi-logo-fallback {
  display: grid;
  place-items: center;
  border: 1px solid #31405a;
  background: linear-gradient(135deg, #18253a, #0c1422);
  color: #93a2b9;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 800;
}

.game-divisi-logo--large,
.game-divisi-logo-fallback--large {
  width: 52px;
  height: 52px;
  border-radius: 10px;
}

.game-divisi-name {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6px;
}

.game-divisi-name > strong {
  overflow: hidden;
  color: #edf1f6;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 700;
  line-height: 13px;
  text-overflow: ellipsis;
}

.game-divisi-name > div {
  display: flex;
  align-items: center;
  gap: 7px;
  min-width: 0;
}

.game-divisi-name span {
  display: inline-flex;
  min-height: 19px;
  align-items: center;
  padding: 0 6px;
  border-radius: 4px;
  background: #182338;
  color: #9aa7ba;
  font-family: "Liberation Mono", monospace;
  font-size: 7px;
  font-weight: 700;
}

.game-divisi-name small {
  overflow: hidden;
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 7px;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-divisi-description {
  display: -webkit-box;
  overflow: hidden;
  margin: 0;
  color: #8895a9;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 400;
  line-height: 12px;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.game-divisi-registration,
.game-divisi-visible {
  display: inline-flex;
  min-height: 22px;
  align-items: center;
  justify-content: center;
  padding: 0 8px;
  border-radius: 999px;
  font-family: Inter, sans-serif;
  font-size: 7px;
  font-weight: 600;
  line-height: 10px;
}

.game-divisi-registration--open {
  background: rgba(34, 197, 94, 0.14);
  color: #22c55e;
}

.game-divisi-registration--closed {
  background: rgba(100, 116, 139, 0.13);
  color: #7d899d;
}

.game-divisi-visible {
  gap: 5px;
  background: rgba(15, 23, 42, 0.55);
  color: #93a0b4;
}

.game-divisi-actions {
  display: flex;
  align-items: center;
  gap: 7px;
}

.game-divisi-edit,
.game-divisi-delete {
  display: inline-flex;
  height: 29px;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  cursor: pointer;
}

.game-divisi-edit {
  gap: 5px;
  min-width: 58px;
  padding: 0 9px;
  border: 1px solid #2c3b55;
  background: #141e30;
  color: #a8b4c6;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 700;
}

.game-divisi-edit--active {
  border-color: rgba(227, 27, 45, 0.7);
  background: rgba(227, 27, 45, 0.13);
  color: #f07e89;
}

.game-divisi-delete {
  width: 29px;
  border: 1px solid #2a374d;
  background: #101827;
  color: #68758b;
}

.game-edit-card {
  margin-top: 18px;
  overflow: hidden;
  scroll-margin-top: 18px;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.08);
}

.game-edit-head {
  display: grid;
  grid-template-columns: 38px minmax(0, 1fr);
  align-items: center;
  gap: 10px;
  padding: 16px 20px;
  border-bottom: 1px solid #253149;
}

.game-edit-head__icon {
  display: grid;
  width: 35px;
  height: 35px;
  place-items: center;
  border-radius: 8px;
  background: rgba(227, 27, 45, 0.17);
  color: #f12539;
}

.game-edit-head__copy {
  min-width: 0;
}

.game-edit-head__title-row {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.game-edit-head__title-row h2 {
  margin: 0;
  color: #f4f7fb;
  font-family: Inter, sans-serif;
  font-size: 13px;
  font-weight: 700;
  line-height: 18px;
}

.game-edit-head__title-row span {
  display: inline-flex;
  height: 21px;
  align-items: center;
  padding: 0 8px;
  border-radius: 5px;
  background: rgba(227, 27, 45, 0.15);
  color: #ef7681;
  font-family: Inter, sans-serif;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.4px;
}

.game-edit-head p {
  margin: 3px 0 0;
  color: #758198;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 400;
  line-height: 11px;
}

.game-edit-body {
  display: grid;
  grid-template-columns: minmax(280px, 0.8fr) minmax(430px, 1.2fr);
  gap: 22px;
  padding: 20px;
}

.game-edit-column {
  min-width: 0;
}

.game-edit-column--text {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.game-edit-field {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.game-edit-field > span,
.game-edit-upload__label,
.game-edit-status-control > span {
  color: #b7c0ce;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 600;
  line-height: 12px;
}

.game-edit-field input,
.game-edit-field textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #2a3852;
  outline: 0;
  border-radius: 8px;
  background: #0d1422;
  color: #eef2f7;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 400;
}

.game-edit-field input {
  height: 38px;
  padding: 0 12px;
}

.game-edit-field textarea {
  min-height: 106px;
  padding: 11px 12px;
  line-height: 15px;
  resize: vertical;
}

.game-edit-field input:focus,
.game-edit-field textarea:focus {
  border-color: rgba(227, 27, 45, 0.6);
  box-shadow: 0 0 0 2px rgba(227, 27, 45, 0.08);
}

.game-edit-field .game-edit-mono {
  font-family: "Liberation Mono", monospace;
  font-weight: 700;
}

.game-edit-column--media {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.game-edit-media-grid,
.game-edit-status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.game-edit-upload {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 7px;
}

.game-edit-upload__preview,
.game-edit-banner-preview {
  display: flex;
  min-height: 76px;
  align-items: center;
  gap: 10px;
  padding: 10px;
  border: 1px solid #2a3852;
  border-radius: 8px;
  background: #0d1422;
}

.game-edit-upload__preview > div,
.game-edit-banner-preview > div:last-child {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4px;
}

.game-edit-upload__preview strong,
.game-edit-banner-preview strong {
  overflow: hidden;
  color: #e3e8f0;
  font-family: "Liberation Mono", monospace;
  font-size: 7px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-edit-upload__preview span,
.game-edit-banner-preview span {
  color: #69768b;
  font-family: Inter, sans-serif;
  font-size: 7px;
  font-weight: 600;
}

.game-edit-upload > button {
  display: inline-flex;
  height: 29px;
  align-items: center;
  justify-content: center;
  gap: 5px;
  border: 1px solid #2b3952;
  border-radius: 6px;
  background: #141e30;
  color: #a9b4c6;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 700;
  cursor: pointer;
}

.game-edit-banner-preview__art {
  width: 68px;
  height: 44px;
  flex: 0 0 68px;
  border-radius: 6px;
  background:
    linear-gradient(135deg, rgba(227, 27, 45, 0.64), rgba(31, 41, 61, 0.18)),
    linear-gradient(145deg, #161f31, #0a0f1a);
  box-shadow: inset 0 0 0 1px #34435e;
}

.game-edit-status-control {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.game-edit-status-control > div {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  overflow: hidden;
  border: 1px solid #2a3852;
  border-radius: 8px;
  background: #0d1422;
}

.game-edit-status-control button {
  display: inline-flex;
  min-height: 34px;
  align-items: center;
  justify-content: center;
  gap: 5px;
  border: 0;
  border-right: 1px solid #2a3852;
  background: transparent;
  color: #738097;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 700;
  cursor: pointer;
}

.game-edit-status-control button:last-child {
  border-right: 0;
}

.game-edit-status-control button.is-active.is-open,
.game-edit-status-control button.is-active.is-visible {
  background: rgba(34, 197, 94, 0.14);
  color: #22c55e;
}

.game-edit-status-control button.is-active.is-closed,
.game-edit-status-control button.is-active.is-hidden {
  background: rgba(100, 116, 139, 0.16);
  color: #a6b0c0;
}

.game-edit-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
  padding: 14px 20px;
  border-top: 1px solid #253149;
  background: rgba(8, 13, 24, 0.38);
}

.game-edit-cancel,
.game-edit-save {
  display: inline-flex;
  height: 34px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 13px;
  border-radius: 7px;
  font-family: Inter, sans-serif;
  font-size: 9px;
  font-weight: 700;
  cursor: pointer;
}

.game-edit-cancel {
  border: 1px solid #2a3750;
  background: #131c2d;
  color: #9ca8ba;
}

.game-edit-save {
  border: 1px solid #e31b2d;
  background: #e31b2d;
  color: #ffffff;
  box-shadow: 0 7px 18px rgba(227, 27, 45, 0.2);
}

@media (max-width: 1050px) {
  .game-edit-body {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .game-divisi-page {
    flex-direction: column;
  }

  .game-divisi-main {
    width: 100%;
    margin-left: 0;
  }

  .game-divisi-content {
    padding: 18px;
  }

  .game-divisi-topbar {
    align-items: stretch;
    flex-direction: column;
  }

  .game-divisi-add {
    align-self: flex-start;
  }

  .game-divisi-table-wrap {
    margin-right: -18px;
    padding-right: 18px;
  }

  .game-edit-body {
    padding: 16px;
  }
}

@media (max-width: 560px) {
  .game-divisi-content {
    padding: 14px;
  }

  .game-edit-media-grid,
  .game-edit-status-grid {
    grid-template-columns: 1fr;
  }

  .game-edit-head {
    padding: 15px 16px;
  }

  .game-edit-head__title-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 6px;
  }

  .game-edit-footer {
    align-items: stretch;
    flex-direction: column-reverse;
    padding: 13px 16px 16px;
  }

  .game-edit-cancel,
  .game-edit-save {
    width: 100%;
  }
}


/* Konten Game / Divisi — Tambah */
.game-edit-helper {
  margin-top: -1px;
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 7px;
  font-weight: 600;
  line-height: 11px;
}

.game-add-upload-box {
  display: flex;
  min-height: 92px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 12px;
  border: 1px dashed #34425c;
  border-radius: 8px;
  background: #0d1422;
  color: #738097;
  text-align: center;
}

.game-add-upload-box svg {
  color: #7f8ba0;
}

.game-add-upload-box strong {
  color: #c7cfdb;
  font-family: Inter, sans-serif;
  font-size: 8px;
  font-weight: 600;
  line-height: 11px;
}

.game-add-upload-box span {
  color: #647087;
  font-family: Inter, sans-serif;
  font-size: 7px;
  font-weight: 400;
  line-height: 10px;
}

.game-add-upload-box--banner {
  min-height: 92px;
}


/* ===== Konten Event (edit) ===== */
.event-page {
  display: flex;
  width: 100%;
  min-height: 100svh;
  background: #080d18;
  color: #f8fafc;
}

.event-main {
  width: calc(100% - 256px);
  min-height: 100svh;
  margin-left: 256px;
  background: #080d18;
}

.event-content {
  padding: 32px;
}

.event-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
}

.event-count {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #e7ebf2;
  font-family: Inter, sans-serif;
  font-size: 11px;
  font-weight: 700;
}

.event-count__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 4px rgba(34,197,94,.11);
}

.event-add {
  display: inline-flex;
  height: 35px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 13px;
  border: 1px solid #e31b2d;
  border-radius: 7px;
  background: #e31b2d;
  color: #fff;
  font: 700 9px Inter, sans-serif;
  cursor: pointer;
  box-shadow: 0 7px 18px rgba(227,27,45,.18);
}

.event-table-card,
.event-edit-card {
  overflow: hidden;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
  box-shadow: 0 14px 34px rgba(0,0,0,.08);
}

.event-table-head {
  display: flex;
  min-height: 52px;
  align-items: center;
  gap: 9px;
  padding: 0 18px;
  border-bottom: 1px solid #253149;
}

.event-table-head h2 {
  margin: 0;
  color: #f3f6fa;
  font: 700 12px/17px Inter, sans-serif;
}

.event-table-wrap {
  overflow-x: auto;
}

.event-table {
  width: 100%;
  min-width: 980px;
  border-collapse: collapse;
  table-layout: fixed;
}

.event-table thead tr {
  background: #0d1422;
}

.event-table th {
  padding: 11px 10px;
  border-bottom: 1px solid #253149;
  color: #647087;
  font: 700 7px/10px Inter, sans-serif;
  letter-spacing: .35px;
  text-align: left;
}

.event-table th:nth-child(1){width:110px}
.event-table th:nth-child(2){width:220px}
.event-table th:nth-child(3){width:150px}
.event-table th:nth-child(4){width:115px}
.event-table th:nth-child(5){width:125px}
.event-table th:nth-child(6){width:70px}
.event-table th:nth-child(7){width:90px}
.event-table th:nth-child(8){width:105px}

.event-table td {
  padding: 12px 10px;
  border-bottom: 1px solid #202c40;
  vertical-align: middle;
}

.event-table tbody tr:last-child td {
  border-bottom: 0;
}

.event-row {
  background: #111a2b;
}

.event-row--editing {
  background: linear-gradient(90deg, rgba(65,20,31,.64), rgba(17,26,43,.96) 42%);
  box-shadow: inset 3px 0 0 #e31b2d;
}

.event-thumb {
  display: grid;
  width: 84px;
  height: 48px;
  place-items: center;
  border: 1px solid #34435e;
  border-radius: 7px;
  color: rgba(255,255,255,.82);
  font: 800 7px Inter, sans-serif;
  letter-spacing: .5px;
  box-shadow: 0 4px 14px rgba(0,0,0,.24);
}

.event-thumb--rektor {
  background: linear-gradient(135deg,#8d101e,#17223a 54%,#101827);
}

.event-thumb--valorant {
  background: linear-gradient(135deg,#ca3346,#2f1521 46%,#0e1727);
}

.event-thumb--mlbb {
  background: linear-gradient(135deg,#183f8d,#1b2d52 50%,#0d1525);
}

.event-name {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.event-name strong {
  color: #edf1f6;
  font: 700 9px/13px Inter, sans-serif;
}

.event-name span {
  display: inline-flex;
  width: fit-content;
  min-height: 19px;
  align-items: center;
  padding: 0 6px;
  border-radius: 4px;
  background: #182338;
  color: #8d99ac;
  font: 600 7px Inter, sans-serif;
}

.event-game-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.event-game-tags span {
  display: inline-flex;
  min-height: 21px;
  align-items: center;
  padding: 0 7px;
  border: 1px solid #31405a;
  border-radius: 5px;
  background: #141e30;
  color: #a6b1c1;
  font: 600 7px Inter, sans-serif;
}

.event-date,
.event-slot {
  color: #929eb1;
  font: 400 8px Inter, sans-serif;
}

.event-prize {
  color: #e9edf4;
  font: 700 8px Inter, sans-serif;
}

.event-status {
  display: inline-flex;
  min-height: 22px;
  align-items: center;
  gap: 5px;
  padding: 0 8px;
  border-radius: 999px;
  font: 700 7px Inter, sans-serif;
}

.event-status--tampil {
  background: rgba(34,197,94,.14);
  color: #22c55e;
}

.event-status--draft {
  background: rgba(234,179,8,.13);
  color: #d5a515;
}

.event-status--selesai {
  background: rgba(100,116,139,.14);
  color: #8793a6;
}

.event-actions {
  display: flex;
  align-items: center;
  gap: 7px;
}

.event-edit,
.event-delete {
  display: inline-flex;
  height: 29px;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  cursor: pointer;
}

.event-edit {
  min-width: 58px;
  gap: 5px;
  padding: 0 9px;
  border: 1px solid #2c3b55;
  background: #141e30;
  color: #a8b4c6;
  font: 700 8px Inter, sans-serif;
}

.event-edit--active {
  border-color: rgba(227,27,45,.7);
  background: rgba(227,27,45,.13);
  color: #f07e89;
}

.event-delete {
  width: 29px;
  border: 1px solid #2a374d;
  background: #101827;
  color: #68758b;
}

.event-edit-card {
  margin-top: 18px;
  scroll-margin-top: 18px;
}

.event-edit-head {
  display: grid;
  grid-template-columns: 38px minmax(0,1fr);
  gap: 10px;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #253149;
}

.event-edit-head__icon {
  display: grid;
  width: 35px;
  height: 35px;
  place-items: center;
  border-radius: 8px;
  background: rgba(227,27,45,.17);
  color: #f12539;
}

.event-edit-head__copy {
  min-width: 0;
}

.event-edit-head__title-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.event-edit-head__title-row h2 {
  margin: 0;
  color: #f4f7fb;
  font: 700 13px/18px Inter, sans-serif;
}

.event-edit-head__title-row span {
  display: inline-flex;
  height: 21px;
  align-items: center;
  padding: 0 8px;
  border-radius: 5px;
  background: rgba(227,27,45,.15);
  color: #ef7681;
  font: 700 7px Inter, sans-serif;
  letter-spacing: .4px;
}

.event-edit-head p {
  margin: 3px 0 0;
  color: #758198;
  font: 400 8px/11px Inter, sans-serif;
}

.event-edit-body {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 20px;
}

.event-edit-grid {
  display: grid;
  gap: 12px;
}

.event-edit-grid--top,
.event-edit-grid--dates,
.event-edit-grid--numbers {
  grid-template-columns: repeat(2,minmax(0,1fr));
}

.event-field,
.event-banner-field,
.event-status-control {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 7px;
}

.event-field > span,
.event-banner-field > span,
.event-status-control > span {
  color: #b7c0ce;
  font: 600 8px/12px Inter, sans-serif;
}

.event-field input,
.event-field textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #2a3852;
  outline: 0;
  border-radius: 8px;
  background: #0d1422;
  color: #eef2f7;
  font: 400 9px Inter, sans-serif;
}

.event-field input {
  height: 38px;
  padding: 0 12px;
}

.event-field textarea {
  min-height: 84px;
  padding: 11px 12px;
  line-height: 15px;
  resize: vertical;
}

.event-field__mono {
  font-family: "Liberation Mono", monospace !important;
  font-size: 8px !important;
}

.event-date-input {
  position: relative;
}

.event-date-input input {
  padding-right: 34px;
}

.event-date-input svg {
  position: absolute;
  top: 50%;
  right: 11px;
  color: #68758a;
  transform: translateY(-50%);
}

.event-game-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.event-game-option {
  display: inline-flex;
  min-height: 31px;
  align-items: center;
  gap: 6px;
  padding: 0 10px;
  border: 1px solid #2b3952;
  border-radius: 7px;
  background: #101827;
  color: #8491a5;
  font: 600 8px Inter, sans-serif;
  cursor: pointer;
}

.event-game-option--active {
  border-color: rgba(227,27,45,.65);
  background: rgba(227,27,45,.10);
  color: #efa0a8;
}

.event-game-option__check {
  display: grid;
  width: 15px;
  height: 15px;
  place-items: center;
  border-radius: 4px;
  background: #18243a;
  font-size: 8px;
}

.event-game-option--active .event-game-option__check {
  background: #e31b2d;
  color: #fff;
}

.event-edit-bottom-grid {
  display: grid;
  grid-template-columns: minmax(0,1.3fr) minmax(260px,.7fr);
  gap: 14px;
}

.event-banner-preview {
  display: grid;
  grid-template-columns: 180px minmax(0,1fr);
  gap: 12px;
  align-items: center;
  padding: 10px;
  border: 1px solid #2a3852;
  border-radius: 8px;
  background: #0d1422;
}

.event-banner-art {
  display: grid;
  height: 94px;
  place-items: center;
  border-radius: 6px;
  color: rgba(255,255,255,.88);
  font: 800 9px Inter, sans-serif;
  letter-spacing: .7px;
  background: linear-gradient(135deg,#8d101e,#17223a 54%,#101827);
}

.event-banner-preview > div:last-child {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5px;
}

.event-banner-preview strong {
  overflow: hidden;
  color: #e3e8f0;
  font: 700 8px "Liberation Mono", monospace;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-banner-preview small {
  color: #69768b;
  font: 600 7px Inter, sans-serif;
}

.event-banner-preview button {
  display: inline-flex;
  width: fit-content;
  height: 28px;
  align-items: center;
  gap: 5px;
  margin-top: 4px;
  padding: 0 9px;
  border: 1px solid #2b3952;
  border-radius: 6px;
  background: #141e30;
  color: #a9b4c6;
  font: 700 8px Inter, sans-serif;
  cursor: pointer;
}

.event-status-control > div {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  overflow: hidden;
  border: 1px solid #2a3852;
  border-radius: 8px;
  background: #0d1422;
}

.event-status-control button {
  min-height: 36px;
  border: 0;
  border-right: 1px solid #2a3852;
  background: transparent;
  color: #768399;
  font: 700 8px Inter, sans-serif;
  cursor: pointer;
}

.event-status-control button:last-child {
  border-right: 0;
}

.event-status-control button.is-active.is-tampil {
  background: rgba(34,197,94,.14);
  color: #22c55e;
}

.event-status-control button.is-active.is-draft {
  background: rgba(100,116,139,.14);
  color: #a6b0c0;
}

.event-status-control button.is-active.is-selesai {
  background: rgba(100,116,139,.14);
  color: #a6b0c0;
}

.event-edit-footer {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  padding: 14px 20px;
  border-top: 1px solid #253149;
  background: rgba(8,13,24,.38);
}

.event-edit-cancel,
.event-edit-save {
  display: inline-flex;
  height: 34px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 13px;
  border-radius: 7px;
  font: 700 9px Inter, sans-serif;
  cursor: pointer;
}

.event-edit-cancel {
  border: 1px solid #2a3750;
  background: #131c2d;
  color: #9ca8ba;
}

.event-edit-save {
  border: 1px solid #e31b2d;
  background: #e31b2d;
  color: #fff;
  box-shadow: 0 7px 18px rgba(227,27,45,.2);
}

@media (max-width: 1050px) {
  .event-edit-bottom-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .event-page {
    flex-direction: column;
  }

  .event-main {
    width: 100%;
    margin-left: 0;
  }

  .event-content {
    padding: 18px;
  }

  .event-topbar {
    align-items: stretch;
    flex-direction: column;
  }

  .event-add {
    align-self: flex-start;
  }

  .event-table-wrap {
    margin-right: -18px;
    padding-right: 18px;
  }

  .event-edit-grid--top,
  .event-edit-grid--dates,
  .event-edit-grid--numbers {
    grid-template-columns: 1fr;
  }

  .event-banner-preview {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 520px) {
  .event-content {
    padding: 14px;
  }

  .event-edit-body {
    padding: 16px;
  }

  .event-edit-head {
    padding: 15px 16px;
  }

  .event-edit-head__title-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 6px;
  }

  .event-edit-footer {
    align-items: stretch;
    flex-direction: column-reverse;
    padding: 13px 16px 16px;
  }

  .event-edit-cancel,
  .event-edit-save {
    width: 100%;
  }
}


/* Konten Event — Tambah */
.event-add-banner-box {
  overflow: hidden;
  border: 1px solid #2a3852;
  border-radius: 8px;
  background: #0d1422;
}

.event-add-banner-drop {
  display: flex;
  min-height: 126px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 18px;
  border-bottom: 1px solid #253149;
  color: #718097;
  text-align: center;
}

.event-add-banner-drop svg {
  color: #7f8ba0;
}

.event-add-banner-drop strong {
  color: #c7cfdb;
  font: 700 8px/12px Inter, sans-serif;
}

.event-add-banner-drop span {
  color: #647087;
  font: 400 7px/10px Inter, sans-serif;
}

.event-add-banner-meta {
  display: flex;
  min-height: 54px;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 9px 10px;
}

.event-add-banner-meta > div {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 3px;
}

.event-add-banner-meta strong {
  color: #aeb8c7;
  font: 600 8px/11px Inter, sans-serif;
}

.event-add-banner-meta span {
  color: #647087;
  font: 400 7px/10px Inter, sans-serif;
}

.event-add-banner-meta button {
  display: inline-flex;
  height: 28px;
  flex: 0 0 auto;
  align-items: center;
  gap: 5px;
  padding: 0 9px;
  border: 1px solid #2b3952;
  border-radius: 6px;
  background: #141e30;
  color: #a9b4c6;
  font: 700 8px Inter, sans-serif;
  cursor: pointer;
}


/* ===== Export Data ===== */
.export-page {
  display: flex;
  width: 100%;
  min-height: 100svh;
  background: #080d18;
  color: #f8fafc;
}

.export-main {
  width: calc(100% - 256px);
  min-height: 100svh;
  margin-left: 256px;
  background: #080d18;
}

.export-content {
  padding: 32px;
}

.export-filter-card,
.export-preview-card {
  overflow: hidden;
  border: 1px solid #253149;
  border-radius: 14px;
  background: #111a2b;
  box-shadow: 0 14px 34px rgba(0,0,0,.08);
}

.export-filter-card {
  padding: 20px;
}

.export-section-head,
.export-preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.export-section-head h2,
.export-preview-head h2 {
  margin: 0;
  color: #f3f6fa;
  font: 700 13px/18px Inter, sans-serif;
}

.export-reset {
  display: inline-flex;
  height: 31px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 10px;
  border: 1px solid #2b3952;
  border-radius: 7px;
  background: #141e30;
  color: #9eabbf;
  font: 600 8px Inter, sans-serif;
  cursor: pointer;
}

.export-filter-grid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  gap: 14px;
  margin-top: 18px;
}

.export-field {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 7px;
}

.export-field > span {
  color: #b7c0ce;
  font: 600 8px/12px Inter, sans-serif;
}

.export-select-wrap,
.export-date-wrap {
  position: relative;
  min-width: 0;
}

.export-select-wrap select,
.export-date-wrap input {
  width: 100%;
  height: 38px;
  box-sizing: border-box;
  border: 1px solid #2a3852;
  outline: 0;
  border-radius: 8px;
  background: #0d1422;
  color: #d7dde7;
  font: 400 9px Inter, sans-serif;
}

.export-select-wrap select {
  padding: 0 34px 0 12px;
  appearance: none;
}

.export-date-wrap input {
  padding: 0 34px 0 12px;
}

.export-select-wrap svg,
.export-date-wrap svg {
  position: absolute;
  top: 50%;
  right: 11px;
  color: #68758a;
  pointer-events: none;
  transform: translateY(-50%);
}

.export-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-top: 17px;
  padding: 12px 14px;
  border-top: 1px solid #253149;
  background: rgba(8,13,24,.18);
}

.export-summary > div {
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.export-summary span,
.export-summary p {
  color: #758198;
  font: 400 8px Inter, sans-serif;
}

.export-summary strong {
  color: #f0f3f7;
  font: 700 10px Inter, sans-serif;
}

.export-summary p {
  margin: 0;
}

.export-preview-card {
  margin-top: 18px;
}

.export-preview-head {
  min-height: 54px;
  padding: 0 18px;
  border-bottom: 1px solid #253149;
}

.export-preview-head > div {
  display: flex;
  align-items: baseline;
  gap: 7px;
}

.export-preview-head > div > span,
.export-preview-head > span {
  color: #758198;
  font: 400 8px Inter, sans-serif;
}

.export-table-wrap {
  width: 100%;
  overflow-x: auto;
}

.export-table {
  width: 100%;
  min-width: 760px;
  border-collapse: collapse;
  table-layout: fixed;
}

.export-table thead tr {
  background: #0d1422;
}

.export-table th {
  padding: 11px 14px;
  border-bottom: 1px solid #253149;
  color: #647087;
  font: 700 7px/10px Inter, sans-serif;
  letter-spacing: .35px;
  text-align: left;
}

.export-table th:nth-child(1){width:23%}
.export-table th:nth-child(2){width:15%}
.export-table th:nth-child(3){width:27%}
.export-table th:nth-child(4){width:13%}
.export-table th:nth-child(5){width:22%}

.export-table td {
  padding: 14px;
  border-bottom: 1px solid #202c40;
  color: #9ca8ba;
  font: 400 8px/12px Inter, sans-serif;
  vertical-align: middle;
}

.export-table tbody tr:last-child td {
  border-bottom: 0;
}

.export-table td strong {
  color: #e8edf4;
  font: 600 9px Inter, sans-serif;
}

.export-mono {
  color: #adb7c6;
  font: 400 8px "Liberation Mono", monospace;
}

.export-game-pill {
  display: inline-flex;
  min-height: 22px;
  align-items: center;
  padding: 0 8px;
  border: 1px solid #31405a;
  border-radius: 999px;
  background: #141e30;
  color: #aab5c5;
  font: 600 7px Inter, sans-serif;
}

.export-bottom {
  display: flex;
  min-height: 62px;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 0 18px;
  border-top: 1px solid #253149;
  background: rgba(8,13,24,.32);
}

.export-bottom > span {
  color: #aab4c5;
  font: 600 9px Inter, sans-serif;
}

.export-bottom button {
  display: inline-flex;
  height: 35px;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 0 13px;
  border: 1px solid #e31b2d;
  border-radius: 7px;
  background: #e31b2d;
  color: #fff;
  font: 600 9px Inter, sans-serif;
  cursor: pointer;
  box-shadow: 0 7px 18px rgba(227,27,45,.20);
}

@media (max-width: 1020px) {
  .export-filter-grid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media (max-width: 760px) {
  .export-page {
    flex-direction: column;
  }

  .export-main {
    width: 100%;
    margin-left: 0;
  }

  .export-content {
    padding: 18px;
  }

  .export-table-wrap {
    margin-right: -18px;
    padding-right: 18px;
  }
}

@media (max-width: 520px) {
  .export-content {
    padding: 14px;
  }

  .export-filter-card {
    padding: 16px;
  }

  .export-filter-grid {
    grid-template-columns: 1fr;
  }

  .export-summary,
  .export-preview-head,
  .export-bottom {
    align-items: flex-start;
    flex-direction: column;
  }

  .export-summary {
    padding: 12px 0 0;
  }

  .export-preview-head {
    min-height: auto;
    padding: 14px 16px;
  }

  .export-bottom {
    padding: 14px 16px;
  }

  .export-bottom button {
    width: 100%;
  }
}
